# =============================================================================
# LOCAL deployment credentials — TEMPLATE ONLY, copy to `.env.production`
#
#   cp .env.production.example .env.production
#
# `.env.production` is gitignored and MUST NEVER be committed.
#
# NAMING DISCIPLINE (do not "unify" these with the CI names)
# -----------------------------------------------------------
#   Local  -> PRODUCTION_FTP_*  (this file)
#   CI     -> FTP_HOST / FTP_USER / FTP_PASSWORD / FTP_REMOTE_PATH
#             (GitHub repository Secrets, never a workflow file)
#
# The two namespaces are deliberately different: a short name typed into the
# wrong place is immediately recognisable, and the source of every credential
# stays identifiable. The deployer reads FTP_* internally; `--env-file` maps
# the PRODUCTION_* names onto them.
# =============================================================================

PRODUCTION_FTP_HOST=
PRODUCTION_FTP_USER=
PRODUCTION_FTP_PASSWORD=
PRODUCTION_FTP_PORT=21

# Remote directory that IS the site document root (no public_html layer).
# Use "/" when the FTP login root is already the docroot.
PRODUCTION_SERVER_PATH=/
