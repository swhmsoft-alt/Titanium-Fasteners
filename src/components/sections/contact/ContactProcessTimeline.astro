---
/**
 * ContactProcessTimeline — 页面底部的四步对接流程。
 *
 * WHY A TIMELINE
 * --------------
 * 首次合作的欧美 B2B 买家最大的隐性成本是「不知道下一步会发生什么」——
 * 他们怕的是发出需求后被拖进一轮轮的澄清邮件。把这四步公开写出来，
 * 等于把「保密 → 报价 → 生产」的路径提前给出，消除未知恐惧。
 *
 * 桌面端横向四栏（lg:grid-cols-4），移动端竖排（连接线改为竖线）。
 */
import { CONTACT_STEPS } from '@data/contact';
---

<section class="container-fluid pb-48 pt-32 lg:pb-56 lg:pt-40" aria-labelledby="contact-process-heading">
	<div class="mb-24 lg:mb-32">
		<p class="text-label mb-8 text-gray-medium">How an engagement runs</p>
		<h2 id="contact-process-heading" class="text-h3 text-blue-dark3">
			From first contact to a certified shipment
		</h2>
	</div>

	<ol class="grid grid-cols-1 gap-24 lg:grid-cols-4 lg:gap-32">
		{
			CONTACT_STEPS.map((item, index) => (
				<li class="relative flex gap-16 lg:block">
					<div class="flex flex-col items-center lg:mb-20 lg:flex-row">
						<span class="flex h-48 w-48 shrink-0 items-center justify-center rounded-pill border-2 border-blue-dark3 text-h5 text-blue-dark3">
							{index + 1}
						</span>
						{index < CONTACT_STEPS.length - 1 && (
							<span
								class="w-2 grow bg-blue-light lg:mt-8 lg:h-2 lg:w-full lg:grow"
								aria-hidden="true"
							/>
						)}
					</div>

					<div class="min-w-0 lg:mt-0">
						<p class="text-label mb-4 text-gray-medium">{item.step}</p>
						<h3 class="text-card mb-8 text-blue-dark3">{item.title}</h3>
						<p class="text-p-sm text-gray">{item.body}</p>
					</div>
				</li>
			))
		}
	</ol>
</section>
