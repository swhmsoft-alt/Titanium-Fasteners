---
/**
 * ContactValueProps — 右栏「为什么欧美买家选择直接对接」的四条定心丸。
 *
 * WHY FOUR, AND WHY THIS ORDER
 * -----------------------------
 * 目标读者只有两种人，四条按「他们的顾虑出现顺序」排：
 *   1. 研发工程师 —— 最怕图纸外泄、怕供应商不懂钛合金加工特性 → 保密 + DFM
 *   2. 采购经理   —— 最怕中间商加价、怕以次充好缺 3.1 证 → 全链路可追溯
 *   3. 分销/仓储  —— 最怕入库要重新贴标、包装不合规 → 分销级包装打标
 *   4. 所有人     —— 最怕石沉大海、机器人绕圈 → 真人工程响应承诺
 *
 * 图标用内联 SVG 而非图片资源：四个单色线性图标不值得引入 4 个 HTTP 请求，
 * 也不依赖 sprite 符号名（sprite 的 symbol 清单不由本页维护）。
 */
import { CONTACT_VALUE_PROPS, type ContactValueProp } from '@data/contact';

const ICONS: Record<ContactValueProp['icon'], string> = {
	shield:
		'<path d="M12 3l7 3v5c0 4.4-2.9 8.4-7 9.6-4.1-1.2-7-5.2-7-9.6V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
	trace:
		'<path d="M4 7h16M4 12h16M4 17h10"/><circle cx="18" cy="17" r="3"/><path d="M20.2 18.2L21.5 19.5"/>',
	package:
		'<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/><path d="M4 7.5l8 4.5 8-4.5"/><path d="M12 12v9"/>',
	clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3.2 2"/>',
};
---

<section aria-labelledby="contact-value-props-heading">
	<h2 id="contact-value-props-heading" class="text-h4 mb-24 text-blue-dark3">
	Engineering & Procurement Assurance
	</h2>

	<ul class="flex flex-col gap-24">
		{
			CONTACT_VALUE_PROPS.map((item) => (
				<li class="flex gap-16">
					<span
						class="flex h-48 w-48 shrink-0 items-center justify-center rounded-pill bg-blue-light text-blue-dark3"
						aria-hidden="true"
					>
						<svg
							class="h-24 w-24"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"
							set:html={ICONS[item.icon]}
						/>
					</span>

					<div class="min-w-0">
						<h3 class="text-card mb-8 text-blue-dark3">{item.title}</h3>
						<p class="text-p-sm text-gray">{item.body}</p>
						{item.href && item.linkLabel && (
							<a
								href={item.href}
								class="mt-8 inline-block text-p-sm text-blue underline underline-offset-4 transition-colors duration-300 hover:text-blue-dark3"
							>
								{item.linkLabel} →
							</a>
						)}
					</div>
				</li>
			))
		}
	</ul>
</section>
