---
/**
 * QualitySupport — 工程质量与品质保障（6 张紧凑卡片，3 列栅格）。
 *
 * LAYOUT_RULES §2.4：抽象清单（认证 / 流程 / 包装规则）必须用**紧凑多列栅格**，
 * 绝不配大图 —— 这一段刻意零图片。
 */
interface Card {
	title: string;
	body: string;
}

interface Props {
	heading: string;
	lead: string;
	cards: Card[];
}

const { heading, lead, cards } = Astro.props;
---

<section class="container-fluid py-48 lg:py-64" aria-labelledby="quality-support-heading">
	<h2 id="quality-support-heading" class="text-h3 mb-12 text-blue-dark3 lg:mb-24">
		{heading}
	</h2>
	<p class="text-p mb-24 max-w-[860px] text-gray lg:mb-32">{lead}</p>

	<ul class="grid grid-cols-1 gap-16 md:grid-cols-2 lg:grid-cols-3 lg:gap-24">
		{
			cards.map((card) => (
				<li class="h-full rounded-card border border-blue-70 bg-white p-24 lg:p-32">
					<h3 class="text-h5 mb-12 font-bold text-blue-dark3">{card.title}</h3>
					<p class="text-p-sm text-gray">{card.body}</p>
				</li>
			))
		}
	</ul>
</section>
