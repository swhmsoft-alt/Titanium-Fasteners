---
/**
 * IntroBlocks — 引言段 + 能力清单 + 结语段（三个独立 container-fluid）。
 *
 * MEASURED on the reference: 清单 8 项，行高 36px（text-list-l 1.25rem/180%）。
 */
interface Props {
	paragraph: string;
	list: string[];
	closing: string;
}

const { paragraph, list, closing } = Astro.props;
---

<div class="container-fluid">
	<p class="text-p max-w-rich-text pb-12 text-gray lg:pb-20">{paragraph}</p>
</div>

<div class="container-fluid">
	<ul
		class="marker:text-blue list-disc max-w-rich-text pb-12 pl-[28px] text-list-l text-gray lg:pb-20 [&>li]:pl-8"
	>
		{list.map((item) => <li>{item}</li>)}
	</ul>
</div>

<div class="container-fluid">
	<p class="text-p max-w-rich-text pb-12 text-gray lg:pb-20">{closing}</p>
</div>
