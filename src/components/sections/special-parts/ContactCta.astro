---
/**
 * ContactCta — 蓝色 CTA 区块（标题 + 文案 + 图 + 联系表单）。
 *
 * MEASURED on the reference (1440×1000, 2026-11-09):
 *   h2 "You Need Special Parts?"  x=102 y=4099  44px 白字
 *   lead p                       x=102 y=4171  20px/32 白字
 *   form h3 "Contact Us"         x=699 y=4308  32px
 *   图                           740×555 (4:3)，圆角左上/右上
 */
interface Props {
	heading: string;
	text: string;
	image: { src: string; alt: string };
	form: {
		title: string;
		note: string;
		countries: string[];
		fields: string[];
		messageLabel: string;
		consent: string;
		consentHref: string;
		submit: string;
	};
}

const { heading, text, image, form } = Astro.props;
---

<div class="relative bg-blue-70">
	<svg class="absolute bottom-0 left-0 h-full w-full" aria-hidden="true">
		<use href="/images/sprite.svg#pattern"></use>
	</svg>
	<div class="container-fluid relative z-1 py-64 sm:pb-72 lg:pb-96 lg:pt-[80px]">
		<div class="lg:ml-24 ul:ml-32">
			<h2 class="text-h3 mb-16 text-white lg:mb-24 ul:w-[55%]">{heading}</h2>
			<div class="text-p mb-16 text-white lg:mb-24 ul:w-[55%]">
				<p>{text}</p>
			</div>
		</div>

		<div class="relative flex flex-wrap items-start justify-between lg:flex-nowrap">
			<div
				class="w-full border-x-[1px] border-transparent lg:-mr-[82%] lg:w-full wd:-mr-[62%] wd:mt-[110px] ul:-mr-[34%] ul:mt-[112px] ul:w-[65%]"
			>
				<figure class="w-full rounded-lg wd:w-[50%] lg:w-[72%] ul:w-[740px]">
					<img
						class="aspect-4/3 w-full rounded-tl-lg rounded-tr-lg sm:rounded-lg"
						src={image.src}
						alt={image.alt}
						width="740"
						height="555"
						loading="lazy"
						style="aspect-ratio:4 / 3"
					/>
				</figure>
			</div>

			<form
				class="relative z-1 w-full rounded-bl-lg rounded-br-lg border-[1px] border-[rgba(204,228,243,1)] bg-white px-24 py-40 shadow-[0_0_20px_0_rgba(0,0,0,0.05)] sm:m-16 sm:-mt-[90px] sm:rounded-lg sm:px-32 lg:ml-auto lg:mt-[44%] lg:w-[698px] lg:py-48 lg:mr-0 wd:mt-0 wd:w-[689px] ul:mt-0"
				action="#"
				method="post"
			>
				<h3 class="text-h4 mb-24 text-blue-dark3">{form.title}</h3>
				<div class="mb-24 text-p-sm text-gray lg:text-p-s">
					<p class="text-p mb-16 text-gray-soft lg:mb-24">{form.note}</p>
				</div>

				<div class="mb-24">
					<label class="relative flex flex-col gap-2">
						<span class="absolute top-8 ml-12 text-p-sm text-gray-medium">Country or Region</span>
						<select
							class="mt-2 w-full appearance-none overflow-x-hidden border-b border-gray-soft bg-transparent px-12 pb-8 pr-32 pt-24 text-p-sm text-ellipsis focus:border-blue focus:outline-none focus:ring-3 focus:ring-blue-light"
						>
							{form.countries.map((c) => <option>{c}</option>)}
						</select>
						<svg
							class="pointer-events-none absolute right-12 top-1/2 h-16 w-16 -translate-y-1/2 text-gray-medium"
							aria-hidden="true"
						>
							<use href="/images/sprite.svg#chevron-down"></use>
						</svg>
					</label>
				</div>

				{
					form.fields.map((f) => (
						<div class="relative mb-24 flex flex-col">
							<label class="relative text-p-sm">
								<input
									class="peer w-full border-b border-gray-soft bg-transparent px-12 pb-8 pt-24 text-p-sm focus:border-blue focus:outline-none focus:ring-3 focus:ring-blue-light"
									type="text"
									name={f}
									placeholder=" "
								/>
								<span class="absolute left-12 top-[16px] -translate-y-12 items-center bg-white text-p-sm text-gray-medium transition-all duration-500 peer-placeholder-shown:translate-y-0 peer-focus:-translate-y-12">
									{f}
								</span>
							</label>
						</div>
					))
				}

				<div class="relative mb-24 flex flex-col">
					<label class="relative text-p-sm">
						<textarea
							class="peer w-full border-b border-gray-soft bg-transparent px-12 pb-8 pt-24 text-p-sm focus:border-blue focus:outline-none focus:ring-3 focus:ring-blue-light"
							name="message"
							rows="3"
							placeholder=" "
						></textarea>
						<span class="absolute left-12 top-[16px] -translate-y-12 flex items-center bg-white text-p-sm text-gray-medium transition-all duration-500 peer-placeholder-shown:translate-y-0 peer-focus:-translate-y-12">
							{form.messageLabel}
						</span>
					</label>
				</div>

				<div class="mb-8">
					<label class="flex cursor-pointer items-center gap-x-3.5 text-p-sm">
						<input class="sr-only" type="checkbox" />
						<span class="relative mr-8 py-[3px]">
							<span class="absolute left-0 top-0 h-18 w-18 rounded-full bg-gray-light shadow-[0_0_4px_0_rgba(0,0,0,0.25)]"></span>
							<span class="block h-[12px] w-[31px] rounded-3xl bg-gray-light"></span>
						</span>
						<span>
							{form.consent}{' '}
							<a class="text-blue underline" href={form.consentHref}>privacy policy</a>
						</span>
					</label>
				</div>

				<span class="mt-24 flex flex-col items-stretch sm:flex-row sm:items-center sm:justify-end">
					<button
						type="submit"
						class="flex w-full items-center justify-center text-button appearance-none cursor-pointer rounded-pill bg-blue px-24 pt-[11px] pb-[12px] font-bold text-white transition-[background-color,color,border-color,box-shadow] duration-100 ease-out hover:bg-blue-dark3 sm:w-auto sm:min-w-[200px]"
					>
						{form.submit}
					</button>
				</span>
			</form>
		</div>
	</div>
</div>
