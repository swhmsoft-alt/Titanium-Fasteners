---
/**
 * ProcessTable — the forming-route matrix.
 *
 * WHY A TABLE, NOT PHOTOS
 * ------------------------
 * A forming route is an abstract choice, not a physical proof. The matrix is
 * therefore rendered as a compact, scrollable table with NO large photography
 * beside it — the gallery section carries the physical proof instead.
 */
import SectionHeading from '@components/ui/SectionHeading.astro';
import type { ProcessRow } from '@data/special-parts';

interface Props {
	eyebrow: string;
	heading: string;
	lead: string;
	rows: readonly ProcessRow[];
}

const { eyebrow, heading, lead, rows } = Astro.props;
---

<section class="container-fluid-wide py-24 lg:py-40" aria-labelledby="process-matrix-heading">
	<SectionHeading
		size="h3"
		as="h2"
		id="process-matrix-heading"
		eyebrow={eyebrow}
		class="mb-16 lg:mb-24"
	>
		{heading}
	</SectionHeading>
	<p class="mb-24 max-w-[820px] text-p text-gray lg:mb-32">{lead}</p>

	{
		rows.length > 0 && (
			<div class="overflow-x-auto">
				<table class="w-full min-w-[840px] border-collapse text-left">
					<thead>
						<tr class="border-b border-blue-70">
							<th scope="col" class="py-12 pr-16 text-label text-gray-medium">
								Forming route
							</th>
							<th scope="col" class="py-12 pr-16 text-label text-gray-medium">
								Batch size
							</th>
							<th scope="col" class="py-12 pr-16 text-label text-gray-medium">
								What it is used for
							</th>
							<th scope="col" class="py-12 text-label text-gray-medium">
								Titanium consideration
							</th>
						</tr>
					</thead>
					<tbody>
						{rows.map((row) => (
							<tr class="border-b border-blue-70 align-top">
								<th scope="row" class="py-16 pr-16 text-p-sm font-bold text-blue-dark3">
									{row.process}
								</th>
								<td class="py-16 pr-16 text-p-sm text-gray">{row.batch}</td>
								<td class="py-16 pr-16 text-p-sm text-gray">{row.bestFor}</td>
								<td class="py-16 text-p-sm text-gray">{row.titanium}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		)
	}

	<p class="mt-12 text-p-sm text-gray-medium">
		Achievable tolerances and lead times are confirmed per part against the
		drawing and the batch quantity.
	</p>
</section>
