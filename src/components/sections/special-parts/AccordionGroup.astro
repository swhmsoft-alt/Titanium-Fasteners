---
/**
 * AccordionGroup — 折叠面板区块（本文的 3 组手风琴共用）。
 *
 * MEASURED on the reference (1440×1000, 2026-11-09):
 *   article "Our Technological Capabilities"  y=2121 h=386  h2 44px
 *   article "Functional Coatings …"           y=2819 h=386  h2 44px
 *   article "Other Custom Services"           y=3433 h=273  h2 44px
 *   面板标题行 pitch 112px（lg:mt-24 + 24×2 padding + 38.4 行高）
 *
 * `variant="media"` 时每项带一张 5:4 图 + 一个灯箱 <dialog>（内含
 * `article.container-fluid.h-svh`，与参考站的 DOM 一致）。
 */
interface Block {
	kind: 'p' | 'label' | 'ul';
	text?: string;
	items?: string[];
}

interface Item {
	title: string;
	body: Block[];
	image?: { src: string; alt: string } | null;
	dialogImage?: { src: string; alt: string } | null;
	caption?: string;
}

interface Props {
	heading: string;
	items: Item[];
	variant?: 'text' | 'media';
}

const { heading, items, variant = 'text' } = Astro.props;
---

<article class="container-fluid mb-48 mt-32 lg:mb-56 lg:mt-40">
	<h2 class="text-h3 mb-16 text-blue-dark2 lg:mb-24">{heading}</h2>
	{
		items.map((item) => (
			<details class="mt-16 rounded-lg border border-blue-light p-16 lg:mt-24 lg:p-24">
				<summary class="relative flex w-full cursor-pointer items-center">
					<h3 class="text-lead mr-16 pr-16 text-blue-dark2 lg:mr-24 lg:pr-24">{item.title}</h3>
					<svg
						class="absolute right-0 h-16 w-16 rotate-0 transition-all duration-300 text-blue-dark3 md:h-24 md:w-24"
						aria-hidden="true"
					>
						<use href="/images/sprite.svg#minus" />
					</svg>
					<svg
						class="absolute right-0 h-16 w-16 -rotate-90 transition-all duration-150 text-blue-dark3 md:h-24 md:w-24"
						aria-hidden="true"
					>
						<use href="/images/sprite.svg#minus" />
					</svg>
				</summary>
				<div class="accordion-details mt-16 border-t border-blue-light pt-16 md:flex md:gap-24 lg:mt-24 lg:gap-32 lg:pt-24">
					{variant === 'media' && item.image && (
						<div class="cursor-pointer">
							<img
								class="aspect-5/4 w-full max-md:mb-12 md:w-[284px] lg:w-[396px]"
								src={item.image.src}
								alt={item.image.alt}
								width="396"
								height="317"
								loading="lazy"
								style="aspect-ratio:5 / 4"
							/>
						</div>
					)}
					<div class="flex-1">
						{item.body.map((b) =>
							b.kind === 'ul' ? (
								<ul class="marker:text-blue list-disc pb-12 pl-[28px] text-list-l text-gray lg:pb-20 [&>li]:pl-8">
									{b.items?.map((li) => (
										<li>{li}</li>
									))}
								</ul>
							) : b.kind === 'label' ? (
								<p class="text-p pb-12 text-gray lg:pb-20">
									<strong>{b.text}</strong>
								</p>
							) : (
								<p class="text-p pb-12 text-gray lg:pb-20">{b.text}</p>
							),
						)}
					</div>
				</div>
				{variant === 'media' && item.dialogImage && (
					<dialog class="h-full max-h-full w-full max-w-full bg-white backdrop:bg-blue-dark backdrop:bg-opacity-80">
						<span class="sr-only">Overlay</span>
						<article class="container-fluid h-svh">
							<header class="flex items-center justify-end py-16 md:py-20 lg:py-24">
								<button class="rounded-full border-2 border-blue-dark3 p-[10px] md:p-[11px]">
									<svg class="h-16 w-16 text-blue-dark3" aria-hidden="true">
										<use href="/images/sprite.svg#close" />
									</svg>
									<span class="sr-only">Close Overlay</span>
								</button>
							</header>
							<div class="flex h-[90vh] min-h-[700px] flex-col justify-center lg:min-h-[900px] wd:min-h-[1000px]">
								<img
									class="aspect-16/9 w-full pb-16 lg:pb-20"
									src={item.dialogImage.src}
									alt={item.dialogImage.alt}
									width="1300"
									height="731"
									loading="lazy"
									style="aspect-ratio:16 / 9"
								/>
								{item.caption && (
									<figcaption class="text-p-sm mt-8 line-clamp-2 h-56 overflow-hidden md:mt-12">
										{item.caption}
									</figcaption>
								)}
							</div>
						</article>
					</dialog>
				)}
			</details>
		))
	}
</article>
