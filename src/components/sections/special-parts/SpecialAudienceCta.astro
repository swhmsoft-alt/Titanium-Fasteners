---
/**
 * SpecialAudienceCta — the closing two-channel conversion block.
 *
 * Two columns — an OEM engineering buyer and a distributor — each with one
 * primary CTA and one secondary route, both pointing at real pages.
 */
import Button from '@components/ui/Button.astro';
import type { AudienceColumn } from '@data/special-parts';

interface Props {
	heading: string;
	lead: string;
	columns: readonly AudienceColumn[];
}

const { heading, lead, columns } = Astro.props;
---

<section class="bg-white py-24 lg:py-32" aria-labelledby="audience-heading">
	<div class="container-fluid-wide">
		<h2 id="audience-heading" class="text-h3 mb-12 text-blue-dark3">{heading}</h2>
		<p class="mb-24 max-w-[820px] text-p text-gray lg:mb-32">{lead}</p>

		<div class="grid grid-cols-1 gap-24 md:grid-cols-2 lg:gap-32">
			{
				columns.map((column) => (
					<article class="flex h-full flex-col rounded-card border border-blue-70 p-16 lg:p-24">
						<figure class="aspect-3/2 w-full overflow-hidden rounded-card">
							<img
								src={column.image.src}
								alt={column.image.alt}
								loading="lazy"
								decoding="async"
								class="h-full w-full object-cover"
							/>
						</figure>
						<h3 class="text-h5 mt-16 mb-8 text-blue-dark3">{column.heading}</h3>
						<p class="mb-16 text-p-sm text-gray">{column.body}</p>
						<dl class="mb-20 border-t border-blue-70 pt-12">
							{column.points.map((point) => (
								<div class="flex justify-between gap-12 border-b border-blue-70 py-8 last:border-b-0">
									<dt class="text-p-sm text-gray-medium">{point.label}</dt>
									<dd class="text-p-sm text-blue-dark3 text-right">{point.value}</dd>
								</div>
							))}
						</dl>
						<div class="mt-auto flex flex-wrap items-center gap-16">
							<Button variant="primary" href={column.cta.href}>
								{column.cta.label}
							</Button>
							<a href={column.secondary.href} class="text-button text-blue hover:underline">
								{column.secondary.label}
							</a>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
