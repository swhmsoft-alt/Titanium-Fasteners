---
/**
 * PageHero — 特殊零件页页头（面包屑 + eyebrow + H1 + lead + 图）。
 *
 * MEASURED on the reference (1440×1000, 2026-11-09):
 *   breadcrumb  y=255  16px/25.6 #666
 *   eyebrow p   y=313  20px #666
 *   h1          y=353  64px/70.4 #004975  w=643
 *   hero figure x=745  634×507 (5:4) rounded-2xl
 */
interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	crumbs: Crumb[];
	eyebrow: string;
	heading: string;
	lead: string;
	image: { src: string; alt: string };
}

const { crumbs, eyebrow, heading, lead, image } = Astro.props;
---

<header
	class="container-fluid mb-64 mt-40 flex flex-col wd:mb-72 wd:mt-48 wd:flex-row wd:items-center wd:gap-32 ul:mb-72 ul:mt-48"
>
	<div class="max-w-full wd:order-1 wd:grow-0 wd:self-center wd:w-1/2 wd:shrink-0 order-2">
		<nav
			class="opacity-100 mb-24 mt-8 overflow-hidden text-gray-medium transition-opacity duration-300 lg:mb-32 lg:mt-12"
			aria-label="Breadcrumb"
		>
			<ol class="flex text-h6-s">
				<li class="flex items-center">
					<a href={crumbs[0].href ?? '/global-en/'} class="breadcrumb L0">
						<svg
							class="h-[16px] w-[16px] fill-gray-medium stroke-gray-medium stroke-[2]"
							aria-hidden="true"
						>
							<use href="/images/sprite.svg#home"></use>
						</svg>
						<span class="sr-only">{crumbs[0].label}</span>
					</a>
				</li>
				<li class="flex items-center">
					<svg
						class="h-[16px] w-[16px] inline-block fill-gray-medium stroke-gray-medium stroke-[1.75] mx-8 lg:mx-12"
						aria-hidden="true"
					>
						<use href="/images/sprite.svg#chevron-right"></use>
					</svg>
					<a href={crumbs[1].href ?? '#'} class="breadcrumb L1 whitespace-nowrap">
						{crumbs[1].label}
					</a>
				</li>
				<li class="flex-shrink-1 flex-grow-0 truncate whitespace-nowrap">
					<svg
						class="h-[16px] w-[16px] inline-block fill-gray-medium stroke-gray-medium stroke-[1.75] mx-8 lg:mx-12 mb-4"
						aria-hidden="true"
					>
						<use href="/images/sprite.svg#chevron-right"></use>
					</svg>
					<span>{crumbs[2].label}</span>
				</li>
			</ol>
		</nav>

		<p class="text-label mb-8 text-gray-medium lg:mb-12">{eyebrow}</p>
		<h1 class="text-h1 mb-24 hyphens-auto text-blue-dark3 lg:mb-32">{heading}</h1>
		<p class="text-lead mb-24 text-gray sm:mb-0">{lead}</p>
	</div>

	<div class="relative mb-24 md:mb-32 wd:order-2 wd:mb-0 wd:w-1/2 wd:shrink-0 wd:grow-0 order-1 sm:mt-0">
		<figure class="flex w-full" data-ratio="1.25">
			<img
				src={image.src}
				alt={image.alt}
				width="634"
				height="507"
				loading="eager"
				fetchpriority="high"
				class="aspect-5/4 flex-shrink-0 w-full rounded-2xl"
				style="aspect-ratio:5 / 4"
			/>
		</figure>
	</div>
</header>
