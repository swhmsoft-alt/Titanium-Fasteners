---
/**
 * FinishNote — "What to Know About the Final Finish" + Learn More 按钮。
 *
 * MEASURED on the reference (1440×1000, 2026-11-09):
 *   h3   y=3261  32px/35.2 #004975（max-w 782）
 *   按钮  y=3336  147×49  18px 白字
 */
import Button from '@components/ui/Button.astro';

interface Props {
	heading: string;
	cta: { label: string; href: string };
}

const { heading, cta } = Astro.props;
---

<div class="container-fluid">
	<h3 class="text-h4 max-w-rich-text pb-24 text-blue-dark3 lg:pb-32">{heading}</h3>
	<div class="container-fluid">
		<div class="flex gap-8 py-8">
			<Button variant="primary" href={cta.href} class="font-bold">{cta.label}</Button>
		</div>
	</div>
</div>
