---
/**
 * ImageRail — 横向滑轨图片区（含灯箱）。
 *
 * 参考站结构：section.container-fluid > div.group.relative > 滑轨 + <dialog> 灯箱。
 * 灯箱内的 `article.container-fluid.h-svh` 与参考站一致（measure 依赖该节点）。
 */
interface Pic {
	src: string;
	alt: string;
}

interface Props {
	slides: Pic[];
	thumbs: Pic[];
	dialogImage?: Pic | null;
	dialogCaption?: string;
}

const { slides, thumbs, dialogImage, dialogCaption = '' } = Astro.props;

/**
 * 减法：只展示前 4 张图片。
 * 参考站是 15 张 + 左右滑动；本站不实现滑动交互，
 * 因此只取 4 张静态排列（见 qa/DEVIATIONS.md 的主动简化记录）。
 */
const VISIBLE = 4;
const visibleSlides = slides.slice(0, VISIBLE);
const visibleThumbs = thumbs.slice(0, VISIBLE);
---

<div class="container-fluid mb-80 mt-32 lg:mb-56">
	<section class="group relative">
		<div class="grid grid-cols-2 gap-32 lg:grid-cols-4">
			{
				visibleSlides.map((pic) => (
					<div class="w-full">
						<figure class="flex w-full cursor-pointer flex-col items-start justify-center">
							<img
								class="aspect-16/9 w-full"
								src={pic.src}
								alt={pic.alt}
								width="300"
								height="169"
								loading="lazy"
								style="aspect-ratio:16 / 9"
							/>
						</figure>
					</div>
				))
			}
		</div>

		{
			dialogImage && (
				<dialog class="h-full max-h-full w-full max-w-full bg-white backdrop:bg-blue-dark backdrop:bg-opacity-80">
					<span class="sr-only">Overlay</span>
					<article class="container-fluid h-svh">
						<header class="flex items-center justify-between py-16 md:py-20 lg:py-24">
							<div class="text-p-sm">
								<span class="text-p text-blue">1</span>/{visibleSlides.length}
							</div>
							<button class="rounded-full border-2 border-blue-dark3 p-[10px] md:p-[11px]">
								<svg class="h-16 w-16 text-blue-dark3" aria-hidden="true">
									<use href="/images/sprite.svg#close" />
								</svg>
								<span class="sr-only">Close Overlay</span>
							</button>
						</header>
						<div class="flex h-[90vh] min-h-[700px] flex-col justify-center lg:min-h-[900px] wd:min-h-[1000px]">
							<img
								class="aspect-16/9 w-full pb-16 lg:pb-20"
								src={dialogImage.src}
								alt={dialogImage.alt}
								width="1300"
								height="731"
								loading="lazy"
								style="aspect-ratio:16 / 9"
							/>
							{dialogCaption && (
								<figcaption class="text-p-sm mt-8 line-clamp-2 h-56 overflow-hidden md:mt-12">
									{dialogCaption}
								</figcaption>
							)}
							<ul class="scrollbar-hidden flex snap-x snap-mandatory gap-16 overflow-x-auto pb-0 lg:gap-20">
								{visibleThumbs.map((thumb) => (
									<li class="relative flex w-[90px] shrink-0 cursor-pointer snap-start items-center md:w-[120px] lg:w-[150px] lg:max-w-[150px]">
										<img
											class="aspect-16/9 w-full"
											src={thumb.src}
											alt={thumb.alt}
											width="300"
											height="169"
											loading="lazy"
											style="aspect-ratio:16 / 9"
										/>
									</li>
								))}
							</ul>
						</div>
					</article>
				</dialog>
			)
		}
	</section>
</div>
