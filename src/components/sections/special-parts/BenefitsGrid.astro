---
/**
 * BenefitsGrid — "Why You Should Procure…" 区块（6 张图标卡，3 列网格）。
 *
 * MEASURED on the reference (1440×1000, 2026-11-09):
 *   article  y=892 h=561   h2 44px（两行）
 *   grid     y=1013 x=70 w=1285  cols 428.33 × 3
 *   卡内 H3  y=1182 / 1402（两行，各 210px 高）
 */
interface Card {
	icon: { src: string; alt: string };
	title: string;
	text: string;
}

interface Props {
	heading: string;
	cards: Card[];
}

const { heading, cards } = Astro.props;
---

<article class="container-fluid mb-48 mt-32 lg:mb-56 lg:mt-40">
	<h2 class="text-h3 mb-16 text-blue-dark2 lg:mb-24">{heading}</h2>
	<div class="grid border-collapse grid-cols-1 sm:grid-cols-2 md:grid-cols-3">
		{
			cards.map((card) => (
				<section class="group relative flex h-[220px] flex-col justify-end overflow-hidden border-b border-l border-r border-blue-70 p-12 pb-24 transition-colors duration-500 first:rounded-tl-lg first:border-t last:rounded-b">
					<figure class="absolute top-16 w-40 transition-all duration-500 group-hover:-top-64 lg:w-48">
						<img
							class="aspect-1/1 w-full"
							src={card.icon.src}
							alt={card.icon.alt}
							width="120"
							height="120"
							loading="lazy"
							style="aspect-ratio:1 / 1"
						/>
					</figure>
					<h3 class="text-h5 text-black">{card.title}</h3>
					<p class="h-0 overflow-hidden text-p-sm text-gray transition-all duration-500 group-hover:h-[100px] sm:group-hover:h-[140px] wd:group-hover:h-[100px]">
						{card.text}
					</p>
				</section>
			))
		}
	</div>
</article>
