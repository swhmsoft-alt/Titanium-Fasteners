---
/**
 * SustainabilitySection — homepage block 7.
 *
 * PHASE A (1:1 COPY). Reference geometry, measured at 1440×1000
 * (docs/reference/homepage-outline.txt, lines 140–157):
 *
 *   article y=4871 h=1013 py-72      .py-56.lg:py-72.bg-white
 *   row     .container-fluid-wide.relative.flex.flex-wrap.justify-between
 *           .px-40.md:flex-nowrap.ul:px-20
 *   figure  952×714  r=1.333         (sustain_esg_KeyVisual_RZ.jpg)
 *   panel   580×519  mt=350          white card with 1px blue-light border
 *           .z-1.relative.h-fit.w-full.rounded-b-lg.bg-white.p-32
 *           .md:right-0.md:mt-[21%].md:w-[512px].md:rounded-lg
 *           .lg:mt-[185px].lg:w-[604px].lg:p-48
 *           .wd:mt-[215px].wd:w-[584px].ul:mt-[25%].ul:w-[580px]
 *           .border-[1px].border-blue-light.shadow-[0_0_20px_0_rgba(0,0,0,0.05)]
 *   label   16px  .mb-12.text-p-l.text-gray-medium.lg:mb-16
 *   h2      44px  .text-h3.mb-24.lg:mb-32.text-blue-dark3.hyphens-auto
 *   body    24px  .text-lead.mb-24.text-gray.lg:mb-32
 */
import Figure from '@components/ui/Figure.astro';
import Button from '@components/ui/Button.astro';
import { SUSTAINABILITY } from '@data/home';
---

<article class="py-56 lg:py-72 bg-white">
		<div
			class="container-fluid-wide relative flex flex-wrap justify-between px-40 md:flex-nowrap ul:px-20"
		>
		<div class="media-col">
			<Figure
				src={SUSTAINABILITY.image.src}
				alt={SUSTAINABILITY.image.alt}
				ratio={1.334}
				class="w-full"
			/>
		</div>

		<div
			class="z-1 relative h-fit w-full rounded-b-lg bg-white p-32 panel-pos md:rounded-lg lg:p-48 border-[1px] border-blue-light shadow-[0_0_20px_0_rgba(0,0,0,0.05)]"
		>
			<p class="mb-12 text-p-l text-gray-medium lg:mb-16">{SUSTAINABILITY.label}</p>
			<h2 class="text-h3 mb-24 lg:mb-32 text-blue-dark3 hyphens-auto">
				{SUSTAINABILITY.heading}
			</h2>
			<p class="text-lead mb-24 text-gray lg:mb-32">{SUSTAINABILITY.body}</p>
			<Button variant="secondary" href={SUSTAINABILITY.cta.href}>
				{SUSTAINABILITY.cta.label}
			</Button>
		</div>
	</div>
</article>
