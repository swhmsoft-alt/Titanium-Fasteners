---
/**
 * AudienceSplitSection — homepage screen 4.
 *
 * ROLE: the two conversion channels side by side. A distributor finds the
 * catalogue; an OEM finds the capability and the paperwork. Both land on a
 * real route.
 */
import Button from '@components/ui/Button.astro';
import ProductFigure from '@components/ui/ProductFigure.astro';
import { AUDIENCE } from '@data/home';
---

<section class="bg-white py-24 lg:py-32" aria-labelledby="audience-heading">
	<div class="container-fluid">
		<h2 id="audience-heading" class="text-h3 mb-12 text-blue-dark3">{AUDIENCE.heading}</h2>
		<p class="mb-24 max-w-[820px] text-p text-gray lg:mb-32">{AUDIENCE.lead}</p>

		<div class="grid grid-cols-1 gap-24 md:grid-cols-2 lg:gap-32">
			{
				AUDIENCE.columns.map((column) => (
					<article class="flex flex-col rounded-card border border-blue-70 p-16 lg:p-24">
						<ProductFigure
							src={column.image.src}
							alt={column.image.alt}
							class="aspect-4/3 w-full"
						/>
						<h3 class="text-h5 mt-16 mb-8 text-blue-dark3">{column.heading}</h3>
						<p class="mb-16 text-p-sm text-gray">{column.body}</p>
						<dl class="mb-20 border-t border-blue-70 pt-12">
							{column.points.map((point) => (
								<div class="flex justify-between gap-12 border-b border-blue-70 py-8 last:border-b-0">
									<dt class="text-p-sm text-gray-medium">{point.label}</dt>
									<dd class="text-p-sm text-blue-dark3 text-right">{point.value}</dd>
								</div>
							))}
						</dl>
						<div class="mt-auto flex flex-wrap items-center gap-16">
							<Button variant="primary" href={column.cta.href}>{column.cta.label}</Button>
							<a href={column.secondary.href} class="text-button text-blue hover:underline">
								{column.secondary.label}
							</a>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
