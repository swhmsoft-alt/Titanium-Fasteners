---
/**
 * HeroSection — homepage screen 1.
 *
 * ROLE: the factory identity + the two conversion doors, in one band.
 * No catalogue filler, no reference-site text.
 *
 * GEOMETRY
 * --------
 * Two columns on desktop (text 7 / figures 5), stacked below 1024px.
 * Vertical rhythm: py-24 / lg:py-32 — deliberately tight, no empty strips.
 */
import Button from '@components/ui/Button.astro';
import { HERO } from '@data/home';
---

<section class="bg-[#0079C2] text-white">
	<div class="container-fluid-wide grid grid-cols-1 gap-32 py-32 lg:grid-cols-12 lg:items-center lg:gap-48 lg:py-40">
		<div class="lg:col-span-7">
			<p class="mb-16 text-xs tracking-wider text-white/80 sm:text-sm">{HERO.eyebrow}</p>
			<h1 class="mb-24 text-4xl leading-[1.15] text-white xl:text-5xl">
				{HERO.heading.map((line) => <span class="block">{line}</span>)}
			</h1>
			<p class="text-p max-w-2xl leading-relaxed text-blue-50/90">{HERO.lead}</p>

			<div class="mt-32 flex flex-wrap gap-16">
				<Button
					variant="primary"
					href={HERO.primaryCta.href}
					class="bg-white! text-[#0A192F]! hover:bg-white/90! hover:text-[#0A192F]! shadow-[0_2px_12px_rgba(10,25,47,0.18)] hover:shadow-[0_6px_20px_rgba(10,25,47,0.28)]"
				>
					{HERO.primaryCta.label}
				</Button>
				<Button variant="outline" href={HERO.secondaryCta.href} class="border-white! text-white! hover:border-blue-dark! hover:bg-white! hover:text-blue-dark!">
					{HERO.secondaryCta.label}
				</Button>
			</div>

			<ul class="mt-48 grid grid-cols-2 gap-16 border-t border-white/15 pt-24 lg:grid-cols-4 lg:gap-24">
				{
					HERO.facts.map((fact) => (
						<li>
							<p class="mb-4 text-xs font-medium tracking-wider text-white/70 uppercase">{fact.label}</p>
							<p class="text-p-sm font-medium text-white">{fact.value}</p>
						</li>
					))
				}
			</ul>
		</div>

		<div class="lg:col-span-5">
			<figure class="overflow-hidden rounded-card border border-white/20">
				<img
					src={HERO.image.src}
					alt={HERO.image.alt}
					class="aspect-4/3 h-full w-full object-cover"
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>
			</figure>
		</div>
	</div>
</section>
