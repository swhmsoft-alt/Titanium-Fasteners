---
/**
 * ProductMatrixSection — homepage screen 5.
 *
 * ROLE: the real product matrix. The families come from PUBLISHED_FAMILIES,
 * so this block can never drift from the catalogue.
 */
import ProductFigure from '@components/ui/ProductFigure.astro';
import { PRODUCT_MATRIX } from '@data/home';
---

<section class="bg-white py-24 lg:py-32" aria-labelledby="matrix-heading">
	<div class="container-fluid">
		<div class="mb-24 flex flex-wrap items-end justify-between gap-16 lg:mb-32">
			<div>
				<h2 id="matrix-heading" class="text-h3 mb-12 text-blue-dark3">{PRODUCT_MATRIX.heading}</h2>
				<p class="max-w-[760px] text-p text-gray">{PRODUCT_MATRIX.lead}</p>
			</div>
			<a href={PRODUCT_MATRIX.all.href} class="text-button text-blue hover:underline">
				{PRODUCT_MATRIX.all.label}
			</a>
		</div>

		<ul class="grid grid-cols-2 gap-16 md:grid-cols-3 lg:grid-cols-5 lg:gap-24">
			{
				PRODUCT_MATRIX.families.map((family) => (
					<li>
						<a
							href={family.href}
							class="group flex h-full flex-col rounded-card border border-blue-70 bg-white p-12 transition duration-200 hover:-translate-y-4 hover:border-blue"
						>
							<ProductFigure
								src={family.image}
								alt={family.alt}
								class="aspect-3/2 w-full"
							/>
							<h3 class="text-p-sm mt-12 mb-4 font-bold leading-tight text-blue-dark3 group-hover:underline">
								{family.title}
							</h3>
							<p class="text-p-sm text-gray-medium">{family.standards}</p>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
