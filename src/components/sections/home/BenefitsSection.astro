---
/**
 * BenefitsSection — homepage block 6.
 *
 * PHASE A (1:1 COPY). Reference geometry, measured at 1440×1000
 * (docs/reference/homepage-outline.txt, lines 118–139):
 *
 *   article y=3703 h=1169 bg #cce4f3  .bg-blue-light.pb-56.pt-40.lg:pb-72.lg:pt-48.ul:pb-96
 *   column .container-fluid.flex.flex-col
 *   h2      44px rgb(0,73,117) mb-48  .text-h3.mb-40.text-blue-dark3.md:text-center.lg:mb-48
 *   grid    .flex.flex-col.flex-wrap.md:flex-row.md:gap-x-[24px].md:gap-y-[40px]
 *           .lg:gap-x-[32px].lg:gap-y-[48px]
 *   item    <details> 411×301  md:border md:rounded-lg
 *           .md:px-16.lg:px-24 .lg:pt-[94px].ul:pt-[106px] .ul:mt-[82px]
 *   cta     .text-button … bg-blue  238×49  centered
 *
 * The reference renders these six items as <details> elements (a
 * disclosure pattern) — reproduced as-is, not as a plain list.
 */
import Button from '@components/ui/Button.astro';
import { BENEFITS } from '@data/home';
---

<article class="bg-blue-light pb-56 pt-40 lg:pb-72 lg:pt-48 ul:pb-96">
	<div class="container-fluid flex flex-col">
		<h2 class="text-h3 mb-40 text-blue-dark3 md:text-center lg:mb-48">{BENEFITS.heading}</h2>

		<div
			class="flex flex-col flex-wrap md:flex-row md:gap-x-24 md:gap-y-40 lg:gap-x-32 lg:gap-y-48"
		>
			{
				BENEFITS.items.map((item, i) => (
					<details
						class="w-full md:w-auto basis-ladder relative flex md:block border-b border-blue-70 md:border-blue-dark3 md:border md:rounded-lg pb-24 md:pb-32 lg:pb-40 md:pt-75 lg:pt-94 ul:pt-106 md:px-16 lg:px-24 md:mt-60 lg:mt-70 ul:mt-82 mb-16 sm:mb-24 md:mb-0"
						open={i === 0 ? '' : undefined}
					>
						<summary class="relative w-full cursor-pointer md:cursor-default md:static md:pointer-events-none">
							<div class="flex items-center md:flex-col md:text-center">
								<figure
									class="mr-16 md:mr-0 md:absolute shrink-0 md:-top-60 lg:-top-70 ul:-top-82 bg-blue-light"
								>
									<img
										src={item.icon.src}
										alt={item.icon.alt}
										width="164"
										height="164"
										loading="eager"
										decoding="async"
										class="aspect-1/1 w-56 h-56 sm:w-88 sm:h-88 md:w-120 md:h-120 lg:w-140 lg:h-140 ul:w-164 ul:h-164"
										style="aspect-ratio:1 / 1"
									/>
								</figure>
								<h3 class="text-lead text-blue-dark">{item.title}</h3>
							</div>
							<svg class="w-16 h-16 absolute right-0 transition-all duration-300 inset-y-1/2 -translate-y-2/4 rotate-180 md:hidden">
								<use href="/images/sprite.svg#minus"></use>
							</svg>
							<svg class="w-16 h-16 absolute right-0 transition-all duration-150 inset-y-1/2 -translate-y-2/4 rotate-0 md:hidden">
								<use href="/images/sprite.svg#minus"></use>
							</svg>
						</summary>
						<p class="text-p ml-72 text-gray sm:ml-104 md:ml-0 md:mt-12 md:text-center">
							{item.body}
						</p>
					</details>
				))
			}
		</div>

		<div class="mt-72 text-center">
			<Button variant="primary" href={BENEFITS.cta.href}>
				{BENEFITS.cta.label}
			</Button>
		</div>
	</div>
</article>
