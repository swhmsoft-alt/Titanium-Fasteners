---
/**
 * PillarsSection — homepage block 5.
 *
 * PHASE A (1:1 COPY). Reference geometry, measured at 1440×1000
 * (docs/reference/homepage-outline.txt, lines 78–117):
 *
 *   article y=3359 h=344 py-48      .container-fluid.grid.grid-cols-1.gap-40
 *                                      .py-32.md:grid-cols-3.md:gap-16.lg:gap-24.lg:py-48
 *   column  417×248  (gap 24)
 *   header  .mb-24.flex.h-[60px].content-start.items-center.lg:mb-32
 *           icon 48×48  .mr-12.lg:mr-16.w-40.lg:w-48.min-w-40.lg:min-w-48
 *           h2  24px    .text-lead.text-blue-dark3
 *   list    li .pb-16.lg:pb-20
 *
 * The three headings (24px) are deliberately smaller than every other
 * section heading (44px) — a reference quirk, reproduced as-is.
 */
import { PILLARS } from '@data/home';
---

<article
	class="container-fluid grid grid-cols-1 gap-40 py-32 md:grid-cols-3 md:gap-16 lg:gap-24 lg:py-48"
>
	{
		PILLARS.items.map((pillar) => (
			<section>
				<div class="mb-24 flex h-60 content-start items-center lg:mb-32">
					<img
						src={pillar.icon.src}
						alt={pillar.icon.alt}
						width="48"
						height="48"
						loading="lazy"
						decoding="async"
						class="mr-12 lg:mr-16 w-40 lg:w-48 min-w-40 lg:min-w-48"
					/>
					<h2 class="text-lead text-blue-dark3">{pillar.heading}</h2>
				</div>
				<ul>
					{pillar.links.map((link) => (
						<li class="pb-16 lg:pb-20">
							<a
								href={link.href}
								class="text-p text-blue-dark3 transition-colors duration-300 hover:text-blue"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</article>
