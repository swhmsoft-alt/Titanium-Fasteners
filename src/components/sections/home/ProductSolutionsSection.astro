---
/**
 * ProductSolutionsSection — homepage block 3.
 *
 * PHASE A (1:1 COPY). Reference geometry, measured at 1440×1000
 * (docs/reference/homepage-outline.txt, lines 40–55):
 *
 *   article y=1933 h=873 pt-24 pb-24  .container-fluid-wide.py-24
 *   grid    y=1989 h=761 gap-32       .lg:grid-cols-8
 *   overlay 1 511×681 lg:col-span-3  md:my-40, figure r=0.75
 *   overlay 2 821×761 lg:col-span-5  figure r=1.079
 *   NOTE: the reference has NO section heading here — the two overlay
 *   headings are <h2> at 32px (text-h4), the reference's deliberate
 *   size/level mismatch, reproduced as-is.
 */
import Figure from '@components/ui/Figure.astro';
import { PRODUCT_SOLUTIONS } from '@data/home';
---

<article class="container-fluid-wide py-24">
	<div
		class="my-24 flex flex-col gap-24 md:grid md:grid-cols-6 md:grid-rows-1 lg:my-32 lg:grid-cols-8 lg:gap-32 wd:grid-cols-12 ul:grid-cols-18"
	>
		{
			PRODUCT_SOLUTIONS.overlays.map((overlay, i) => (
				<a
					href={overlay.href}
					class:list={[
						'relative rounded-2xl bg-[linear-gradient(0deg,rgba(0,0,0,0.3),rgba(0,0,0,0))]',
						i === 0
							? 'md:w-auto md:my-40 md:col-span-2 lg:col-span-3 wd:col-span-5 ul:col-span-7'
							: 'sm:mb-20 md:w-auto md:mb-0 md:col-span-4 lg:col-span-5 wd:col-span-7 ul:col-span-11',
					]}
				>
					<Figure
						src={overlay.image.src}
						alt={overlay.image.alt}
						ratio={overlay.image.ratio}
						class="relative -z-1 rounded-2xl w-full"
					/>
					<div class="container-fluid absolute bottom-24 px-32 lg:bottom-32 lg:px-48">
						<h2 class="text-h4 font-bold pb-24 text-white lg:text-h4-l">
							{overlay.heading}
						</h2>
						<p class="text-lead hidden pb-32 text-white wd:block">{overlay.body}</p>
						<div>
							<svg class="lg:w-32 mb-0 h-24 w-24 pb-0 lg:h-32 stroke-white">
								<use href="/images/sprite.svg#arrow-right-bold"></use>
							</svg>
						</div>
					</div>
				</a>
			))
		}
	</div>
</article>
