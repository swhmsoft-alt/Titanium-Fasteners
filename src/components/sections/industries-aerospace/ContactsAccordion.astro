---
/**
 * ContactsAccordion — "Bossard Aerospace Contacts" 国家手风琴（5 国 / 6 条联系方式）。
 *
 * MEASURED on the reference (1440×1000, 2026-11-10):
 *   article  y=5866 h=610   container-fluid mb-48 mt-32 lg:mb-56 lg:mt-40
 *   h2      44px
 *   details mt-16 rounded-lg border border-blue-light p-16 lg:mt-24 lg:p-24
 *   summary 标题行 text-lead 24px #00314e + 右侧 minus 图标（开合切换）
 *   body    accordion-details mt-16 border-t border-blue-light pt-16 md:flex
 *
 * The reference ships every panel CLOSED — the measured 610px is the height of
 * five collapsed rows, so the local copy must not open them by default.
 */
interface ContactLink {
	label: string;
	value: string;
	href: string;
}

interface Entry {
	company: string;
	address: string[];
	phone: ContactLink | null;
	email: ContactLink | null;
}

interface Country {
	country: string;
	entries: Entry[];
}

interface Props {
	heading: string;
	countries: Country[];
}

const { heading, countries } = Astro.props;
---

<article class="container-fluid mb-48 mt-32 lg:mb-56 lg:mt-40">
	<h2 class="text-h3 mb-16 lg:mb-24 text-blue-dark2">{heading}</h2>
	{
		countries.map((country, index) => (
			<details
				class="mt-16 rounded-lg border border-blue-light p-16 lg:mt-24 lg:p-24"
				id={`acc-${index}-${country.country.replace(/\s+/g, '-')}`}
			>
				<summary class="relative flex w-full cursor-pointer items-center">
					<h3 class="text-lead mr-16 pr-16 text-blue-dark2 lg:mr-24 lg:pr-24">{country.country}</h3>
					<svg
						class="absolute right-0 transition-all duration-300 rotate-0 w-16 h-16 md:w-24 md:h-24"
						aria-hidden="true"
					>
						<use href="/images/sprite.svg#minus"></use>
					</svg>
					<svg
						class="absolute right-0 transition-all duration-150 -rotate-90 w-16 h-16 md:w-24 md:h-24"
						aria-hidden="true"
					>
						<use href="/images/sprite.svg#minus"></use>
					</svg>
				</summary>
				<div class="accordion-details mt-16 border-t border-blue-light pt-16 md:flex md:gap-24 lg:mt-24 lg:gap-32 lg:pt-24">
					<div>
						{country.entries.map((entry) => (
							<p class="text-p pb-12 text-gray lg:pb-20">
								<strong>{entry.company}</strong>
								<br />
								{entry.address.map((line) => (
									<>
										{line}
										<br />
									</>
								))}
								{entry.phone && (
									<>
										{entry.phone.label}{' '}
										<a
											class="cursor-pointer text-blue underline focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-blue-dark"
											href={entry.phone.href}
										>
											{entry.phone.value}
										</a>
										<br />
									</>
								)}
								{entry.email && (
									<>
										{entry.email.label}{' '}
										<a
											class="cursor-pointer text-blue underline focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-blue-dark"
											href={entry.email.href}
										>
											{entry.email.value}
										</a>
									</>
								)}
							</p>
						))}
					</div>
				</div>
			</details>
		))
	}
</article>
