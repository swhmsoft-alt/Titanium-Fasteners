---
/**
 * NewsOverview — "News Overview" 区块（6 条行业新闻，2 列网格）。
 *
 * MEASURED on the reference (1440×1000, 2026-11-10):
 *   article  y=3473 h=774   container-fluid my-48
 *   h2      44px #00314e  (text-h3 mb-16 text-blue-dark2 lg:mb-24)
 *   grid    2 cols, gap-24 → lg:gap-32
 *   thumb   202×202 @ul, rounded-lg, 1:1
 *   date    20px #00314e   title 21px   excerpt 18px gray
 */
interface Item {
	href: string;
	image: string;
	alt: string;
	date?: string;
	title: string;
	body: string;
}

interface Props {
	heading: string;
	items: Item[];
}

const { heading, items } = Astro.props;
---

<article class="container-fluid my-48">
	<h2 class="text-h3 mb-16 text-blue-dark2 lg:mb-24">{heading}</h2>

	<div class="grid grid-cols-1 gap-24 md:grid-cols-2 lg:gap-32">
		{
			items.map((item) => (
				<section class="group cursor-pointer">
					<a class="flex" href={item.href}>
						<figure class="w-[108px] sm:w-[166px] md:w-[114px] lg:w-[144px] wd:w-[176px] ul:w-[202px] shrink-0">
							<img
								class="aspect-1/1 rounded-lg object-cover max-w-max w-full"
								src={item.image}
								alt={item.alt}
								width="202"
								height="202"
								loading="lazy"
								decoding="async"
								style="aspect-ratio:1 / 1"
							/>
						</figure>
						<div class="pl-16 lg:pl-24">
						{item.date && (
						 <p class="text-label mb-8 text-blue-dark3">{item.date}</p>
						)}
						<h3 class="text-h5 mb-16 text-blue-dark group-hover:underline">{item.title}</h3>
							<p class="text-p-sm text-gray">{item.body}</p>
						</div>
					</a>
				</section>
			))
		}
	</div>
</article>
