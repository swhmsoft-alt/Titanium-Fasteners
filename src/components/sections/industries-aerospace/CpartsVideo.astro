---
/**
 * CpartsVideo — "Your Trusted C-Parts Management Partner" 视频区块。
 *
 * MEASURED on the reference (1440×1000, 2026-11-10):
 *   article  y=4295 h=903   container-fluid pb-48 pt-32 lg:pb-56 lg:pt-40
 *   h2      44px            video 16:9 占位（pt-[56.25%]）
 *   play    288×288 圆点
 *
 * KNOWN DEVIATION: the reference poster lives on img.youtube.com and is not
 * reachable from the build host, so the remote URL is kept (see
 * qa/DEVIATIONS.md). The 16:9 box keeps the measured height intact.
 */
interface Props {
	heading: string;
	poster: string;
	posterAlt: string;
	caption?: string;
}

const { heading, poster, posterAlt, caption } = Astro.props;
---

<article class="container-fluid pb-48 pt-32 lg:pb-56 lg:pt-40">
	<h2 class="text-h3 mb-16 lg:mb-24 text-blue-dark3">{heading}</h2>
	<div
		class="relative mb-8 w-full cursor-pointer overflow-hidden pt-[56.25%] sm:pt-[56.25%] lg:mb-12 rounded-2xl"
		data-testid="video-wrapper"
	>
		<img
			class="[clip-path: inset(0% 0% 0% 0% round 1rem)] absolute bottom-0 left-0 right-0 top-0 h-full w-full border-0 bg-blue-light object-cover"
			src={poster}
			alt={posterAlt}
			loading="lazy"
			decoding="async"
		/>
		<div
			class="absolute left-1/2 top-1/2 flex h-72 w-72 -translate-x-1/2 -translate-y-1/2 transform items-center justify-center rounded-full bg-blue"
		>
			<svg class="h-32 w-32 fill-blue stroke-white" aria-hidden="true">
				<use href="/images/sprite.svg#play"></use>
			</svg>
		</div>
	</div>
	{caption && <p class="text-p-sm">{caption}</p>}
</article>
