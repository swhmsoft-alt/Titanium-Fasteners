---
/**
 * Hero — Bossard Aerospace 页首（文字 + 右侧 5:4 图）。
 *
 * MEASURED on the reference (1440×1000, 2026-11-10):
 *   header  container-fluid mb-64 mt-40 flex flex-col wd:flex-row wd:items-center wd:gap-32
 *   crumb   3 级（Home / Industries / Aerospace）
 *   label   20px gray-medium   h1 64px #004975   lead 24px
 *   image   634×507 aspect-5/4, rounded-2xl, w-1/2 @wd
 */
interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	breadcrumb: Crumb[];
	eyebrow: string;
	heading: string;
	lead: string;
	image: { src: string; alt: string; width: number; height: number };
}

const { breadcrumb, eyebrow, heading, lead, image } = Astro.props;
---

<header
	class="container-fluid mb-64 mt-40 flex flex-col wd:mb-72 wd:mt-48 wd:flex-row wd:items-center wd:gap-32 ul:mb-72 ul:mt-48"
>
	<div class="max-w-full wd:order-1 wd:grow-0 wd:self-center wd:w-1/2 wd:shrink-0 order-2">
		<nav
			class="opacity-1 mb-24 mt-8 overflow-hidden text-gray-medium transition-opacity duration-300 lg:mb-32 lg:mt-12"
			aria-label="Breadcrumb"
		>
			<ol class="flex text-h6-s">
				<li class="flex items-center">
					<a href={breadcrumb[0].href} class="breadcrumb L0">
						<svg
							class="h-[16px] w-[16px] fill-gray-medium stroke-gray-medium stroke-[2]"
							aria-hidden="true"
						>
							<use href="/images/sprite.svg#home"></use>
						</svg>
						<span class="sr-only">{breadcrumb[0].label}</span>
					</a>
				</li>
				{
					breadcrumb.slice(1, -1).map((crumb) => (
						<li class="flex items-center">
							<svg
								class="h-[16px] w-[16px] inline-block fill-gray-medium stroke-gray-medium stroke-[1.75] mx-8 lg:mx-12"
								aria-hidden="true"
							>
								<use href="/images/sprite.svg#chevron-right"></use>
							</svg>
							<a href={crumb.href} class="breadcrumb L1 whitespace-nowrap">
								{crumb.label}
							</a>
						</li>
					))
				}
				<li class="flex-shrink-1 flex-grow-0 truncate whitespace-nowrap">
					<svg
						class="h-[16px] w-[16px] inline-block fill-gray-medium stroke-gray-medium stroke-[1.75] mx-8 lg:mx-12 mb-4"
						aria-hidden="true"
					>
						<use href="/images/sprite.svg#chevron-right"></use>
					</svg>
					<span>{breadcrumb[breadcrumb.length - 1].label}</span>
				</li>
			</ol>
		</nav>

		<p class="text-label mb-8 text-gray-medium lg:mb-12">{eyebrow}</p>
		<h1 class="text-h1 mb-24 hyphens-auto text-blue-dark3 lg:mb-32">{heading}</h1>
		<p class="text-lead mb-24 text-gray sm:mb-0">{lead}</p>
	</div>

	<div
		class="relative mb-24 md:mb-32 wd:order-2 wd:mb-0 wd:w-1/2 wd:shrink-0 wd:grow-0 order-1 sm:mt-0"
	>
		<figure class="flex w-full">
			<img
				class="aspect-5/4 flex-shrink-0 w-full rounded-2xl"
				src={image.src}
				alt={image.alt}
				width={image.width}
				height={image.height}
				loading="eager"
				decoding="async"
				style="aspect-ratio:5 / 4"
			/>
		</figure>
	</div>
</header>
