---
/**
 * DataCentersCallout — the "Data Centers" callout block.
 *
 * MEASURED on the reference (1440×1000, 2026-11-10):
 *   article   y=4065 h=913  bg #ffffff, py-72 at lg
 *   figure    x=20  942×706  (4:3) at y=4137
 *   text card x=873 484 wide  label 20px → h2 44px → lead 24px → button 147×49
 */
import type { DataCentersCallout } from '@data/industries';

interface Props {
	dataCenters: DataCentersCallout;
}

const { dataCenters } = Astro.props;
---

<article class="py-56 lg:py-72 bg-white">
	<div class="container-fluid-wide relative flex flex-wrap justify-between px-40 md:flex-nowrap ul:px-20">
		<div
			class="w-full md:-mr-[34%] md:w-[68%] lg:-mr-[38%] lg:w-[72%] wd:w-[65%] ul:-mr-[163px] ul:w-[68%]"
		>
			<figure class="w-full">
				<img
					class="aspect-4/3 w-full h-full object-cover rounded-t-lg md:rounded-lg"
					src={dataCenters.image}
					alt={dataCenters.alt}
					width={dataCenters.imageWidth}
					height={dataCenters.imageHeight}
					loading="eager"
					style="aspect-ratio:4 / 3"
				/>
			</figure>
		</div>
		<div
			class="z-1 relative h-fit w-full rounded-b-lg bg-white p-32 md:right-0 md:mt-[21%] md:w-[512px] md:rounded-lg lg:mt-[185px] lg:w-[604px] lg:p-48 wd:mt-[215px] wd:w-[584px] ul:mt-[25%] ul:w-[580px] border-[1px] border-blue-light shadow-[0_0_20px_0_rgba(0,0,0,0.05)]"
		>
			<p class="mb-12 text-p-l text-gray-medium lg:mb-16">{dataCenters.label}</p>
			<h2 class="text-h3 mb-24 lg:mb-32 text-blue-dark3 hyphens-auto">{dataCenters.heading}</h2>
			<p class="text-lead mb-24 text-gray lg:mb-32">{dataCenters.text}</p>
			<a
				class="inline-flex items-center justify-center rounded-pill border-2 border-blue-dark3 px-24 py-13 pb-14 text-button font-bold text-blue-dark3 transition-colors duration-300 hover:bg-blue-dark3 hover:text-white"
				href={dataCenters.ctaHref}
			>
				{dataCenters.ctaLabel}
			</a>
		</div>
	</div>
</article>
