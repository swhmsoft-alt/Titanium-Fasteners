---
/**
 * IndustryCards — the two-up industry grid (used four times on this page).
 *
 * MEASURED on the reference (1440×1000, 2026-11-10):
 *   article  y=604 / 1469 / 2335 / 3200   h=865   container-fluid-wide py-24
 *   grid     x=38 w=1349 gap=32, 18 cols @ul
 *   wide     col-span-11 → 812 wide, aspect-5/4 (834×667)
 *   narrow   col-span-7  → 505 wide, aspect-3/4 (530×707), md:my-40
 *   overlay  h2 32px white, lead 24px white, arrow-right-bold 24→32px
 */
import type { IndustryCard } from '@data/industries';

interface Props {
	cards: IndustryCard[];
}

const { cards } = Astro.props;

const SPAN = {
	wide: 'sm:mb-20 md:w-auto md:mb-0 md:col-span-4 lg:col-span-5 wd:col-span-7 ul:col-span-11',
	narrow: 'md:w-auto md:my-40 md:col-span-2 lg:col-span-3 wd:col-span-5 ul:col-span-7',
} as const;
---

<article class="container-fluid-wide py-24">
	<div
		class="my-24 flex flex-col gap-24 md:grid md:grid-cols-6 md:grid-rows-1 lg:my-32 lg:grid-cols-8 lg:gap-32 wd:grid-cols-12 ul:grid-cols-18"
	>
		{
			cards.map((card) => (
				<a
					class={`${SPAN[card.span]} relative rounded-2xl bg-[linear-gradient(0deg,rgba(0,0,0,0.3),rgba(0,0,0,0))]`}
					href={card.href}
				>
					<figure class="relative -z-1 h-full rounded-2xl w-full">
						<img
							class={`${card.span === 'wide' ? 'aspect-5/4' : 'aspect-3/4'} w-full h-full object-cover rounded-2xl`}
							src={card.image}
							alt={card.alt}
							width={card.imageWidth}
							height={card.imageHeight}
							loading="eager"
							style={`aspect-ratio:${card.span === 'wide' ? '5 / 4' : '3 / 4'}`}
						/>
					</figure>
					<div class="absolute bottom-24 px-32 lg:bottom-32 lg:px-48">
						<h2 class="text-h4 font-bold pb-24 text-white">{card.title}</h2>
						<p class="text-lead hidden pb-32 text-white wd:block">{card.description}</p>
						<div>
							<svg class="lg:w-32 mb-0 h-24 w-24 pb-0 lg:h-32 stroke-white" aria-hidden="true">
								<use href="/images/sprite.svg#arrow-right-bold"></use>
							</svg>
						</div>
					</div>
				</a>
			))
		}
	</div>
</article>
