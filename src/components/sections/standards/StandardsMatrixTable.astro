---
/**
 * StandardsMatrixTable — 可实时筛选的标准型号总览表。
 *
 * SSR 铁律
 * --------
 * 全部行用原生 <table>/<thead>/<tbody>/<th>/<td> 渲染并**全量输出到 HTML**，
 * 爬虫与 AI 不执行 JS 也能读到每一个标准号。筛选只是前端状态，
 * 通过 data 属性控制行的显示，不做 DOM 重建。
 *
 * 交互
 * ----
 * 原生 JS（无 island）：关键词搜索 + 品类标签，输入即时过滤，
 * 计数同步更新。无 JS 时表格仍然完整可读。
 */
import type { StandardRow } from '@data/standards-hub';
import { STANDARD_CATEGORIES } from '@data/standards-hub';

interface Props {
	/** 表格 id，供 aria 关联。 */
	tableId: string;
	/** 表头描述（caption）。 */
	caption: string;
	/** 搜索框 placeholder。 */
	placeholder: string;
	rows: StandardRow[];
	/** 可选：表格上方的说明段。缺省则不渲染。 */
	intro?: string;
	/** 可选：表格主说明。缺省则用 DIN/ISO 版默认文案。 */
	summary?: string;
}

const { tableId, caption, placeholder, rows, intro, summary } = Astro.props;

/**
 * 只渲染本表真实出现的品类标签 —— 避免出现「点开是 0 条」的空标签
 * （DIN / ISO 页没有材料类，ASTM/ASME 页才有）。
 */
const presentCategories = new Set<string>(rows.map((row) => row.category));
const visibleCategories = STANDARD_CATEGORIES.filter(
	(category) => category.id === 'all' || presentCategories.has(category.id)
);
---

<section class="bg-white pb-48 pt-32 lg:pb-56 lg:pt-40" aria-labelledby={`${tableId}-heading`}>
	<div class="container-fluid">
		<h2 id={`${tableId}-heading`} class="text-h3 mb-12 text-blue-dark3 lg:mb-24">
			Standard specification matrix
		</h2>
		<p class="mb-24 max-w-[860px] text-p text-gray">
			{
				summary ??
				'Search by standard number or product name, or narrow the list to a fastener category. Every entry is produced in our own shop from certified titanium bar.'
			}
		</p>
		{
			intro && (
				<p class="mb-24 max-w-[860px] text-p-sm leading-relaxed text-gray-medium">{intro}</p>
			)
		}

		<div class="mb-24 flex flex-col gap-16 lg:flex-row lg:items-center lg:justify-between">
			<div class="flex-1">
				<label for={`${tableId}-search`} class="sr-only">Search standards</label>
				<input
					id={`${tableId}-search`}
					type="search"
					placeholder={placeholder}
					autocomplete="off"
					class="w-full max-w-[520px] border border-gray-light bg-white px-16 py-13 text-p-sm text-gray placeholder:text-gray-medium focus:border-blue focus:outline-none"
				/>
			</div>
			<div class="flex flex-wrap gap-8" role="group" aria-label="Filter by fastener category">
				{
					visibleCategories.map((category) => (
						<button
							type="button"
							data-filter-category={category.id}
							aria-pressed={category.id === 'all' ? 'true' : 'false'}
							class="rounded-pill border border-gray-light px-16 py-8 text-p-sm leading-none text-gray-medium transition-colors duration-200 hover:border-blue hover:text-blue-dark3 aria-pressed:border-blue-dark3 aria-pressed:bg-blue-dark3 aria-pressed:text-white"
						>
							{category.label}
						</button>
					))
				}
			</div>
		</div>

		<p class="mb-16 text-p-sm text-gray-medium" aria-live="polite" data-result-count>
			Showing {rows.length} of {rows.length} standards
		</p>

		<div class="overflow-x-auto">
			<table id={tableId} class="w-full min-w-[1040px] border-collapse text-left">
				<caption class="sr-only">{caption}</caption>
				<thead>
					<tr class="border-b-2 border-blue-dark3">
						<th scope="col" class="py-12 pr-16 text-p-sm font-bold text-blue-dark3">Standard No.</th>
						<th scope="col" class="py-12 pr-16 text-p-sm font-bold text-blue-dark3">Product Name</th>
						<th scope="col" class="py-12 pr-16 text-p-sm font-bold text-blue-dark3">Equivalent Standard</th>
						<th scope="col" class="py-12 pr-16 text-p-sm font-bold text-blue-dark3">Size Range</th>
						<th scope="col" class="py-12 pr-16 text-p-sm font-bold text-blue-dark3">Available Grades</th>
						<th scope="col" class="py-12 pr-16 text-p-sm font-bold text-blue-dark3">Availability</th>
						<th scope="col" class="py-12 text-p-sm font-bold text-blue-dark3">Action</th>
					</tr>
				</thead>
				<tbody>
					{
						rows.map((row) => (
							<tr
								data-standard-row
								data-category={row.category}
								data-search={`${row.standard} ${row.product} ${row.equivalent}`.toLowerCase()}
								class="border-b border-gray-vlight align-top"
							>
								<th scope="row" class="py-14 pr-16 text-p-sm">
									<a href={row.href} class="font-bold text-blue underline underline-offset-4 hover:text-blue-dark3">
										{row.standard}
									</a>
								</th>
								<td class="py-14 pr-16 text-p-sm text-gray">{row.product}</td>
								<td class="py-14 pr-16 text-p-sm text-gray-medium">{row.equivalent}</td>
								<td class="py-14 pr-16 text-p-sm text-gray">{row.size}</td>
								<td class="py-14 pr-16 text-p-sm">
									<span class="flex flex-wrap gap-4">
										{row.grades.map((grade) => (
											<span class="rounded-pill border border-blue-70 px-8 py-2 text-p-sm leading-none text-blue-dark3">
												{grade}
											</span>
										))}
									</span>
								</td>
								<td class="py-14 pr-16 text-p-sm text-gray">{row.availability}</td>
								<td class="py-14 text-p-sm">
									<button
										type="button"
										data-quote-standard={row.standard}
										class="rounded-pill border border-blue-dark3 px-16 py-8 text-p-sm leading-none text-blue-dark3 transition-colors duration-200 hover:bg-blue-dark3 hover:text-white"
									>
										Quick Quote
									</button>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>

		<p class="mt-24 text-p-sm text-gray">
			Size ranges reflect the sizes held as production tooling. Larger or smaller sizes, and
			other tolerance classes, are machined to order against your drawing.
		</p>
	</div>
</section>

<script define:vars={{ tableId }}>
	const searchInput = document.getElementById(`${tableId}-search`);
	const table = document.getElementById(tableId);
	const rows = Array.from(table.querySelectorAll('[data-standard-row]'));
	const countEl = document.querySelector(`[data-result-count][data-for="${tableId}"]`) ||
		document.querySelector('[data-result-count]');
	const categoryButtons = Array.from(document.querySelectorAll('[data-filter-category]'));

	let activeCategory = 'all';

	const applyFilters = () => {
		const term = (searchInput?.value || '').trim().toLowerCase();
		let visible = 0;

		rows.forEach((row) => {
			const matchesTerm = !term || row.dataset.search.includes(term);
			const matchesCategory =
				activeCategory === 'all' || row.dataset.category === activeCategory;
			const show = matchesTerm && matchesCategory;
			row.hidden = !show;
			if (show) visible += 1;
		});

		if (countEl) {
			countEl.textContent = `Showing ${visible} of ${rows.length} standards`;
		}
	};

	searchInput?.addEventListener('input', applyFilters);

	categoryButtons.forEach((button) => {
		button.addEventListener('click', () => {
			activeCategory = button.dataset.filterCategory;
			categoryButtons.forEach((other) => {
				const isActive = other === button;
				other.setAttribute('aria-pressed', isActive ? 'true' : 'false');
			});
			applyFilters();
		});
	});

	/* ── Quick Quote → 派发事件，由页脚询盘表单接收 ───────────────── */
	table.querySelectorAll('[data-quote-standard]').forEach((button) => {
		button.addEventListener('click', () => {
			const standard = button.dataset.quoteStandard;
			window.dispatchEvent(new CustomEvent('boze:quote-standard', { detail: standard }));
			document.getElementById('rfq')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
	});
</script>
