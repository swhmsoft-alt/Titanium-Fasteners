---
/**
 * KnowledgeHubItemGrid — Knowledge Hub 的条目卡网格。
 *
 * 几何沿用 sections/about-us/AboutUsItemGrid.astro（同一套边框/内距/排版刻度），
 * 数据契约换成 @data/knowledge-hub 的 KnowledgeHubItem —— 卡片链接由数据层给出，
 * 组件本身不拼路径。
 *
 * 落地页按三列渲染（每列一个 group），详情页用它渲染同组的其它条目。
 */
import type { KnowledgeHubItem } from '@data/knowledge-hub';

interface Props {
	items: KnowledgeHubItem[];
}

const { items } = Astro.props;
---

<ul class="grid grid-cols-1 gap-24 md:grid-cols-2 lg:grid-cols-3 lg:gap-32">
	{
		items.map((item) => (
			<li class="border border-blue-70 rounded-lg">
				<a class="block h-full p-12 pb-24 lg:p-16 lg:pb-28" href={item.href}>
					<h3 class="text-h5 mb-8 text-blue-dark3">{item.name}</h3>
					<p class="text-p-sm text-gray">{item.description}</p>
					<span class="mt-16 inline-flex items-center text-button text-blue">
						Read more
						<svg class="h-16 w-16 stroke-blue ml-8" aria-hidden="true">
							<use href="/images/sprite.svg#arrow-right" />
						</svg>
					</span>
				</a>
			</li>
		))
	}
</ul>
