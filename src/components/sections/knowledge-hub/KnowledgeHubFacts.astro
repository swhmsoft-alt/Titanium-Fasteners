---
/**
 * KnowledgeHubFacts — 详情页的「关键事实」表。
 *
 * 几何复用 sections/about-us/AboutUsFacts.astro；只列能落到物证的说法
 * （证书类型、管控流程、范围、口径），每行 label + value。
 */
import AboutUsFacts from '@components/sections/about-us/AboutUsFacts.astro';
import type { KnowledgeHubFact } from '@data/knowledge-hub';

interface Props {
	facts: KnowledgeHubFact[];
	heading?: string;
}

const { facts, heading } = Astro.props;
---

<AboutUsFacts facts={facts} heading={heading} />
