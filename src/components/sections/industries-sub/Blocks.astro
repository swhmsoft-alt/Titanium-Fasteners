---
/**
 * Blocks — dispatcher for the `industries-sub` page type.
 *
 * The 8 industry sub pages share this block vocabulary. Blocks that the
 * aerospace page already implements are reused from that component family
 * (Hero / NewsOverview / CpartsVideo / SupportCards) so the two page types
 * stay visually identical where the reference is identical.
 *
 * Two block kinds are rendered verbatim instead of being re-modelled:
 *   media   - the CMS accordion; its nested <article class="h-svh"> lightbox
 *             body and the island boundary decide the reference block count.
 *   gallery - the image rail; it is a top level <section> on the reference
 *             (inside an Astro island) and is wrapped in a <div> here so it
 *             stays out of the `main > section` selector of the measurement.
 */
import Hero from '@components/sections/industries-aerospace/Hero.astro';
import NewsOverview from '@components/sections/industries-aerospace/NewsOverview.astro';
import CpartsVideo from '@components/sections/industries-aerospace/CpartsVideo.astro';
import SupportCards from '@components/sections/industries-aerospace/SupportCards.astro';
import MediaAccordion from './MediaAccordion.astro';
import ContactBand from './ContactBand.astro';
import Brochure from './Brochure.astro';
import CtaBand from './CtaBand.astro';
import RichText from './RichText.astro';
import type { IndustrySubBlock } from '@data/industries-sub/types';

interface Props {
	blocks: IndustrySubBlock[];
}

const { blocks } = Astro.props;
---

{
	blocks.map((block) => {
		switch (block.kind) {
			case 'hero':
				return (
					<Hero
						breadcrumb={block.breadcrumb}
						eyebrow={block.eyebrow}
						heading={block.heading}
						lead={block.lead}
						image={block.image}
					/>
				);
			case 'contactBand':
				return (
					<ContactBand
						heading={block.heading}
						text={block.text}
						icon={block.icon}
						ctaLabel={block.ctaLabel}
						ctaHref={block.ctaHref}
					/>
				);
			case 'media':
				return <MediaAccordion html={block.html} />;
			case 'gallery':
				return <MediaAccordion html={block.html} gallery />;
			case 'raw':
				return <MediaAccordion html={block.html} raw />;
			case 'supportCards':
				return <SupportCards heading={block.heading} cards={block.cards} />;
			case 'iconCards':
				return <NewsOverview heading={block.heading} items={block.items} />;
			case 'video':
				return (
					<CpartsVideo
						heading={block.heading}
						poster={block.poster}
						posterAlt={block.posterAlt}
						caption={block.caption}
					/>
				);
			case 'brochure':
				return <Brochure heading={block.heading} items={block.items} />;
			case 'ctaBand':
				return (
					<CtaBand
						heading={block.heading}
						eyebrow={block.eyebrow}
						image={block.image}
						description={block.description}
						cta={block.cta}
					/>
				);
			case 'richText':
				return <RichText paragraphs={block.paragraphs} />;
		}
	})
}
