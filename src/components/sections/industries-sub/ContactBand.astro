---
/**
 * ContactBand — "Get in Touch With Our Industry Team" band.
 *
 * Reference markup (qa/ref/industries-medical.html):
 *   <article class="container-fluid relative">
 *     <div class="relative my-48 block items-center rounded-lg border border-blue-70 px-24 py-32
 *                 hover:bg-blue-light sm:flex lg:my-64 lg:p-48 ul:px-[140px]">
 *       <figure class="mb-40 sm:mb-0 shrink-0 sm:mr-40 lg:mr-48 ul:mr-54 w-96 lg:w-120">
 *         <img class="aspect-1/1 w-full">
 *       <div>
 *         <h2 class="text-h5 mb-16 text-blue-dark3 lg:mb-24">
 *         <p class="text-p-sm mb-24 lg:mb-32">
 *         <button type="button" class="after:content-[''] … text-button …">
 *
 * KNOWN DEVIATION: the reference button opens a contact form dialog. This
 * build has no form island, so the button is rendered as a link to the
 * contact page (see qa/DEVIATIONS.md).
 */
interface Props {
	heading: string;
	text: string;
	icon: { src: string; alt: string };
	ctaLabel: string;
	ctaHref?: string;
}

const { heading, text, icon, ctaLabel, ctaHref } = Astro.props;

const BTN_BASE =
	'text-button appearance-none cursor-pointer transition-[box-shadow,border-color,background-color,color,text-decoration-color] ease-out duration-100 font-bold rounded-[28px] inline-block text-center px-24 pt-[11px] pb-[12px] lg:pt-[13px] lg:pb-[14px]';
const BTN_SECONDARY =
	'bg-transparent text-blue-dark3 border-2 border-blue-dark3 hover:bg-transparent hover:text-blue hover:border-blue hover:ring-2 hover:ring-blue hover:ring-offset-0';
---

<article class="container-fluid relative">
	<div
		class="relative my-48 block items-center rounded-lg border border-blue-70 px-24 py-32 hover:bg-blue-light sm:flex lg:my-64 lg:p-48 ul:px-[140px]"
	>
		<figure class="mb-40 sm:mb-0 shrink-0 sm:mr-40 lg:mr-48 ul:mr-54 w-96 lg:w-120">
			<img
				class="aspect-1/1 w-full"
				src={icon.src}
				alt={icon.alt}
				loading="eager"
				decoding="async"
				style="aspect-ratio:1 / 1"
			/>
		</figure>
		<div>
			<h2 class="text-h5 mb-16 text-blue-dark3 lg:mb-24">{heading}</h2>
			<p class="text-p-sm mb-24 lg:mb-32">{text}</p>
			<a class={`${BTN_BASE} ${BTN_SECONDARY}`} href={ctaHref || '/global-en/contact/'}>
				{ctaLabel}
			</a>
		</div>
	</div>
</article>
