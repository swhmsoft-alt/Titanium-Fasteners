---
/**
 * Brochure — "Download More Information …" brochure list.
 *
 * Reference markup (qa/ref/industries-medical.html):
 *   <article class="container-fluid my-48">
 *     <h2 class="text-lead mb-16 lg:mb-24 text-black">
 *     <div class="grid grid-cols-1 gap-x-24 gap-y-32 md:grid-cols-2 lg:gap-x-32">
 *       <section class="flex">
 *         <figure class="w-[101px] lg:w-[105px]">
 *           <img class="aspect-3/4 rounded-lg object-cover max-w-max border border-blue-light">
 *         <div class="pl-16 lg:pl-24">
 *           <h3 class="text-h5 mb-16 text-blue-dark">
 *           <p class="text-p-sm pb-16 text-gray">
 *           <a href="…pdf" download="" target="_blank" rel="noreferrer noopener"
 *              class="flex items-center gap-x-4 text-p-s uppercase text-blue">
 */
import type { Img } from '@data/industries-sub/types';

interface Item {
	href: string;
	image: Img;
	title: string;
	description: string;
	label: string;
}

interface Props {
	heading: string;
	items: Item[];
}

const { heading, items } = Astro.props;
---

<article class="container-fluid my-48">
	<h2 class="text-lead mb-16 lg:mb-24 text-black">{heading}</h2>

	<div class="grid grid-cols-1 gap-x-24 gap-y-32 md:grid-cols-2 lg:gap-x-32">
		{
			items.map((item) => (
				<section class="flex">
					<figure class="w-[101px] lg:w-[105px]">
						<img
							class="aspect-3/4 rounded-lg object-cover max-w-max border border-blue-light"
							src={item.image.src}
							alt={item.image.alt}
							width={item.image.width}
							height={item.image.height}
							loading="lazy"
							decoding="async"
							style="aspect-ratio:3 / 4"
						/>
					</figure>
					<div class="pl-16 lg:pl-24">
						<h3 class="text-h5 mb-16 text-blue-dark">{item.title}</h3>
						{item.description && (
							<p class="text-p-sm pb-16 text-gray">{item.description}</p>
						)}
						{item.href && (
							<a
								href={item.href}
								download
								target="_blank"
								rel="noreferrer noopener"
								class="flex items-center gap-x-4 text-p-s uppercase text-blue"
							>
								<span class="relative">{item.label}</span>
							</a>
						)}
					</div>
				</section>
			))
		}
	</div>
</article>
