---
/**
 * MediaAccordion — verbatim renderer for the blocks this build does not
 * re-model (the CMS accordion, its image rail and any leftover reference
 * block).
 *
 * WHY verbatim
 * ------------
 * The reference wraps the accordion and the image rail in separate Astro
 * islands. The measurement enumerates `main article, main > section`, so the
 * island boundary decides which elements are compared:
 *   - the accordion article is measured (it is an <article>),
 *   - its nested lightbox body <article class="container-fluid h-svh"> is
 *     measured too (hidden, so y=0 h=0),
 *   - the image rail is a top level <section> INSIDE an island, therefore
 *     `main > section` does not match it and it is not compared directly —
 *     its height still shows up in the y offset of the next block.
 * Rendering the reference markup keeps that count and those heights.
 *
 * The gallery is wrapped in a <div> so it does not become a direct child of
 * <main> (which would add a block the reference does not have).
 *
 * SPRITE URL NORMALISATION
 * ------------------------
 * The captured reference markup points its <use> elements at the reference
 * site's own hashed build asset, e.g. /_astro/sprite.CNhkymMS.svg#minus.
 * That file never existed in this project, so every icon on the industry
 * sub pages resolved to a 404.
 *
 * This site ships one sprite sheet at /images/sprite.svg, and it carries the
 * two symbols the captured markup actually uses (minus, close). The fix is
 * therefore applied at RENDER time — the generated data files under
 * src/data/industries-sub/ are build artifacts and must not be hand-edited,
 * and the upstream generator that produced them is no longer part of this
 * repository, so they cannot be regenerated either.
 *
 * Only the path is rewritten; the fragment (#minus / #close) is preserved.
 */
interface Props {
	html: string;
	gallery?: boolean;
	raw?: boolean;
}

const { html: rawHtml, gallery = false, raw = false } = Astro.props;

/** Reference build asset → this site's sprite sheet. */
const html = rawHtml.replaceAll(
	'/_astro/sprite.CNhkymMS.svg',
	'/images/sprite.svg',
);
---

{
	gallery ? (
		<div>
			<Fragment set:html={html} />
		</div>
	) : (
		<Fragment set:html={html} />
	)
}
