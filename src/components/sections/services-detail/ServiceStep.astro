---
/**
 * ServiceStep — one numbered "copy-text-image" article of a benefit page.
 *
 * MEASURED on the reference (1440×1000, 2026-11-10,
 * /services/benefits/cost-saving-rationalization/):
 *   article   y= 688 h=516   cls "container-fluid py-64 md:py-80"
 *   wrapper  mb-20 flex flex-col items-center gap-20 md:flex-row md:gap-24
 *   image    420×336 (5/4)  | copy column w=841, h2 21.008px, p 18px, CTA 49px
 *   the image column carries `md:order-last` on alternating steps, which is
 *   what flips the layout — the DOM order never changes.
 */
import type { ServiceStep } from '@data/services-detail/benefits-cost-saving-rationalization';

interface Props {
	step: ServiceStep;
}

const { step } = Astro.props;
---

<article class="container-fluid py-64 md:py-80">
	<div
		class="mb-20 flex flex-col items-center gap-20 md:flex-row md:gap-24"
		data-testid="copy-text-image-wrapper"
	>
		<div class:list={['sm:w-full md:w-1/3', !step.imageFirst && 'md:order-last']}>
			<figure class="h-full w-full">
				<img
					src={step.image.src}
					alt={step.image.alt}
					width={step.image.width}
					height={step.image.height}
					loading="eager"
					class="aspect-5/4 w-full h-full rounded-2xl"
					style="aspect-ratio:5 / 4"
				/>
			</figure>
		</div>
		<div class="md:w-2/3">
			<h2 class="text-h5-l mb-16 ul:mb-24">{step.heading}</h2>
			<p class="text-p pb-12 text-gray lg:pb-20">{step.body}</p>
			{
				step.cta && (
					<section class="container-fluid p-0 float-left pb-32">
						<div class="flex gap-8 py-8">
							<a
								class="text-button appearance-none cursor-pointer transition-[box-shadow,border-color,background-color,color,text-decoration-color] ease-out duration-100 font-bold rounded-pill inline-block text-center px-24 pt-[11px] pb-[12px] lg:pt-[13px] lg:pb-[14px] bg-blue text-white border-2 border-blue hover:bg-blue hover:border-blue-dark3"
								href={step.cta.href}
							>
								{step.cta.label}
							</a>
						</div>
					</section>
				)
			}
		</div>
	</div>
</article>
