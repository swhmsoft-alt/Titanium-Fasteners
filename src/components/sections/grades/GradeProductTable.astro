---
/**
 * GradeProductTable — 该牌号可供应的产品族总览表。
 *
 * SSR 铁律
 * --------
 * 全部行用原生 <table> 渲染并**全量输出到 HTML**，爬虫与 AI 不执行 JS
 * 也能读到每一个族名与标准号。筛选只是前端状态，通过 data 属性控制行的显示。
 *
 * 交互：原生 JS 关键词搜索 + 输入即时过滤，计数同步更新。无 JS 时表格完整可读。
 */
import type { GradeProductRow } from '@data/grade-hub';

interface Props {
	/** 表格 id，供 aria 关联与脚本定位。 */
	tableId: string;
	/** 表头描述（caption）。 */
	caption: string;
	/** 搜索框 placeholder。 */
	placeholder: string;
	/** 牌号名（用于表头与提示语）。 */
	grade: string;
	rows: GradeProductRow[];
}

const { tableId, caption, placeholder, grade, rows } = Astro.props;
---

<section class="bg-white pb-48 pt-32 lg:pb-56 lg:pt-40" aria-labelledby={`${tableId}-heading`}>
	<div class="container-fluid">
		<h2 id={`${tableId}-heading`} class="text-h3 mb-12 text-blue-dark3 lg:mb-24">
			{grade} product range
		</h2>
		<p class="mb-24 max-w-[860px] text-p text-gray">
			Every family below is produced in {grade} and listed with the thread range, length
			range and finishes held as production tooling. Sizes outside these ranges, and other
			tolerance classes, are machined to order against your drawing.
		</p>

		<div class="mb-24 flex flex-col gap-16 lg:flex-row lg:items-center lg:justify-between">
			<div class="flex-1">
				<label for={`${tableId}-search`} class="sr-only">Search {grade} product families</label>
				<input
					id={`${tableId}-search`}
					type="search"
					placeholder={placeholder}
					autocomplete="off"
					class="w-full max-w-[520px] border border-gray-light bg-white px-16 py-13 text-p-sm text-gray placeholder:text-gray-medium focus:border-blue focus:outline-none"
				/>
			</div>
		</div>

		<p class="mb-16 text-p-sm text-gray-medium" aria-live="polite" data-result-count>
			Showing {rows.length} of {rows.length} product families
		</p>

		<div class="overflow-x-auto">
			<table id={tableId} class="w-full min-w-[960px] border-collapse text-left">
				<caption class="sr-only">{caption}</caption>
				<thead>
					<tr class="border-b-2 border-blue-dark3">
						<th scope="col" class="py-12 pr-16 text-p-sm font-bold text-blue-dark3">Product</th>
						<th scope="col" class="py-12 pr-16 text-p-sm font-bold text-blue-dark3">Standard</th>
						<th scope="col" class="py-12 pr-16 text-p-sm font-bold text-blue-dark3">Thread</th>
						<th scope="col" class="py-12 pr-16 text-p-sm font-bold text-blue-dark3">Length</th>
						<th scope="col" class="py-12 pr-16 text-p-sm font-bold text-blue-dark3">Finishes</th>
						<th scope="col" class="py-12 text-p-sm font-bold text-blue-dark3">Quote</th>
					</tr>
				</thead>
				<tbody>
					{
						rows.map((row) => (
							<tr
								data-product-row
								data-search={`${row.title} ${row.standards} ${row.finishes}`.toLowerCase()}
								class="border-b border-gray-vlight align-top"
							>
								<th scope="row" class="py-14 pr-16 text-p-sm">
									<a href={row.href} class="font-bold text-blue underline underline-offset-4 hover:text-blue-dark3">
										{row.title}
									</a>
								</th>
								<td class="py-14 pr-16 text-p-sm text-gray-medium">{row.standards}</td>
								<td class="py-14 pr-16 text-p-sm text-gray">{row.threadRange}</td>
								<td class="py-14 pr-16 text-p-sm text-gray">{row.lengthRange}</td>
								<td class="py-14 pr-16 text-p-sm text-gray">{row.finishes}</td>
								<td class="py-14 text-p-sm">
									<button
										type="button"
										data-quote-product={row.title}
										class="rounded-pill border border-blue-dark3 px-16 py-8 text-p-sm leading-none text-blue-dark3 transition-colors duration-200 hover:bg-blue-dark3 hover:text-white"
									>
										Quick Quote
									</button>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>
</section>

<script define:vars={{ tableId }}>
	const searchInput = document.getElementById(`${tableId}-search`);
	const table = document.getElementById(tableId);
	const rows = Array.from(table.querySelectorAll('[data-product-row]'));
	const countEl = document.querySelector(`[data-result-count][data-for="${tableId}"]`) ||
		document.querySelector('[data-result-count]');

	const applyFilters = () => {
		const term = (searchInput?.value || '').trim().toLowerCase();
		let visible = 0;

		rows.forEach((row) => {
			const show = !term || row.dataset.search.includes(term);
			row.hidden = !show;
			if (show) visible += 1;
		});

		if (countEl) {
			countEl.textContent = `Showing ${visible} of ${rows.length} product families`;
		}
	};

	searchInput?.addEventListener('input', applyFilters);

	/* ── Quick Quote → 派发事件，由询盘表单接收 ─────────────────────── */
	table.querySelectorAll('[data-quote-product]').forEach((button) => {
		button.addEventListener('click', () => {
			const product = button.dataset.quoteProduct;
			window.dispatchEvent(new CustomEvent('boze:quote-standard', { detail: product }));
			document.getElementById('rfq')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
	});
</script>
