---
/**
 * NextStepCta — closing call to action of
 * `/product-solutions/innovations/`: heading + lead + one photo + button.
 *
 * 2026-11-25: the hero contact card was removed from this page, so this
 * closing section is now the page's conversion point. The button links to
 * the real `/contact/` route; the previous `<dialog>` drawer carried no
 * open handler and has been replaced by this band.
 */
interface Props {
	heading: string;
	lead: string;
	buttonLabel: string;
	buttonHref: string;
	image: string;
	imageAlt: string;
	imageWidth: number;
	imageHeight: number;
}

const {
	heading,
	lead,
	buttonLabel,
	buttonHref,
	image,
	imageAlt,
	imageWidth,
	imageHeight,
} = Astro.props;
---

<div class="container-fluid">
	<h2 class="text-h3 pb-24 text-blue-dark3 max-w-rich-text lg:pb-32">{heading}</h2>
</div>

<section class="container-fluid">
	<div class="flex flex-col items-center gap-24 wd:flex-row wd:items-center wd:gap-48">
		<div class="wd:w-1/2 wd:shrink-0">
			<p class="text-p pb-24 text-gray max-w-rich-text lg:pb-32">{lead}</p>
			<a
				href={buttonHref}
				class="text-button inline-block appearance-none cursor-pointer rounded-[28px] bg-blue px-24 py-16 text-center font-bold text-white transition-[background-color,color] duration-100 ease-out hover:bg-blue-dark3"
			>
				{buttonLabel}
			</a>
		</div>

		<figure class="w-full wd:w-1/2 wd:shrink-0">
			<img
				class="aspect-4/3 w-full object-cover"
				src={image}
				alt={imageAlt}
				width={imageWidth}
				height={imageHeight}
				loading="lazy"
				style="aspect-ratio:4 / 3"
			/>
		</figure>
	</div>
</section>
