---
/**
 * PageHero — breadcrumb + H1 + lead + image + contact card of
 * `/global-en/product-solutions/innovations/`.
 *
 * MEASURED on the reference (1440×1000, 2026-11-10):
 *   hero figure   x=745 y=267 w=643 h=514 (5:4)
 *   breadcrumb    y=290 (16px)
 *   eyebrow p     y=348  20px #666
 *   h1            y=388  64px/70.4 #004975 (3 lines)
 *   lead p        y=631  24px/38.4 #333 (3 lines)
 *   contact card  x=920 w=362 — "Contact Us" h2 y=434, submit y=1079 362×49
 */
import type { BreadcrumbItem, ContactForm } from '@data/innovations';

interface Props {
	breadcrumb: BreadcrumbItem[];
	eyebrow: string;
	heading: string;
	lead: string;
	image: string;
	imageAlt: string;
	imageWidth: number;
	imageHeight: number;
	form: ContactForm;
}

const {
	breadcrumb,
	eyebrow,
	heading,
	lead,
	image,
	imageAlt,
	imageWidth,
	imageHeight,
	form,
} = Astro.props;
---

<header
	class="container-fluid mb-64 mt-40 flex flex-col wd:mb-72 wd:mt-48 wd:flex-row wd:items-center wd:gap-32 ul:mb-72 ul:mt-48"
>
	<div class="max-w-full wd:order-1 wd:grow-0 wd:self-center wd:w-1/2 wd:shrink-0 md:order-2">
		<nav
			class="opacity-1 mb-24 mt-8 overflow-hidden text-gray-medium transition-opacity duration-300 lg:mb-32 lg:mt-12"
			aria-label="Breadcrumb"
		>
			<ol class="flex text-p-l">
				<li class="flex items-center">
					<a href={breadcrumb[0].href} class="breadcrumb L0">
						<svg
							class="h-[16px] w-[16px] fill-gray-medium stroke-gray-medium stroke-[2]"
							aria-hidden="true"
						>
							<use href="/images/sprite.svg#home"></use>
						</svg>
						<span class="sr-only">{breadcrumb[0].label}</span>
					</a>
				</li>
				<li class="flex items-center">
					<svg
						class="h-[16px] w-[16px] inline-block fill-gray-medium stroke-gray-medium stroke-[1.75] mx-8 lg:mx-12"
						aria-hidden="true"
					>
						<use href="/images/sprite.svg#chevron-right"></use>
					</svg>
					<a href={breadcrumb[1].href} class="breadcrumb L1 whitespace-nowrap">
						{breadcrumb[1].label}
					</a>
				</li>
				<li class="flex-shrink-1 flex-grow-0 truncate whitespace-nowrap">
					<svg
						class="h-[16px] w-[16px] inline-block fill-gray-medium stroke-gray-medium stroke-[1.75] mx-8 lg:mx-12 mb-4"
						aria-hidden="true"
					>
						<use href="/images/sprite.svg#chevron-right"></use>
					</svg>
					<span>{breadcrumb[2].label}</span>
				</li>
			</ol>
		</nav>

		<p class="text-label mb-8 text-gray-medium lg:mb-12">{eyebrow}</p>
		<h1 class="text-h1 mb-24 hyphens-auto text-blue-dark3 lg:mb-32">{heading}</h1>
		<p class="text-lead mb-24 text-gray sm:mb-0">{lead}</p>
	</div>

	<div
		class="relative mb-24 md:mb-32 wd:order-2 wd:mb-0 wd:w-1/2 wd:shrink-0 wd:grow-0 order-1 sm:mt-24 md:order-1 md:max-wd:mb-56 md:max-wd:pr-[280px]"
	>
		<figure class="flex w-full" data-ratio="1.25">
			<img
				src={image}
				alt={imageAlt}
				width={imageWidth}
				height={imageHeight}
				loading="eager"
				fetchpriority="high"
				class="aspect-5/4 md:object-cover flex-shrink-0 w-full rounded-tl-2xl rounded-tr-2xl md:rounded-2xl"
				style="aspect-ratio:5 / 4"
			/>
		</figure>

		<div
			class="z-1 w-full overflow-x-hidden rounded-bl-lg rounded-br-lg border-[1px] border-[rgba(204,228,243,1)] bg-white p-20 shadow-[0_0_20px_0_rgba(0,0,0,0.05)] md:absolute md:right-0 md:w-[360px] md:rounded-lg"
		>
			<form action="#" method="post">
				<h2 class="mb-24 text-blue-dark3 text-h5">{form.title}</h2>
				<div class="mb-24 text-p-sm text-gray lg:text-p-s"></div>

				<div class="mb-24">
					<label class="relative flex flex-col gap-2">
						<span class="absolute top-8 ml-12 text-p-sm text-gray-medium">Country or Region</span>
						<select
							class="mt-2 w-full appearance-none overflow-x-hidden border-b border-gray-soft bg-transparent px-12 pb-8 pr-32 pt-24 text-p-sm text-ellipsis focus:border-blue focus:outline-none focus:ring-3 focus:ring-blue-light"
						>
							{form.countries.map((c) => <option>{c}</option>)}
						</select>
						<svg
							class="pointer-events-none absolute right-12 top-1/2 h-16 w-16 -translate-y-1/2 text-gray-medium"
							aria-hidden="true"
						>
							<use href="/images/sprite.svg#chevron-down"></use>
						</svg>
					</label>
				</div>

				{
					form.fields.map((f) => (
						<div class="relative mb-24 flex flex-col">
							<label class="relative text-p-sm">
								<input
									class="peer w-full border-b border-gray-soft bg-transparent px-12 pb-8 pt-24 text-p-sm focus:border-blue focus:outline-none focus:ring-3 focus:ring-blue-light"
									type="text"
									name={f}
									placeholder=" "
								/>
								<span class="absolute left-12 top-[16px] -translate-y-12 items-center bg-white text-p-sm text-gray-medium transition-all duration-500 peer-placeholder-shown:translate-y-0 peer-focus:-translate-y-12">
									{f}
									<span class="ml-[2px] text-blue">*</span>
								</span>
							</label>
						</div>
					))
				}

				<div class="relative mb-24 flex flex-col">
					<label class="relative text-p-sm">
						<textarea
							class="peer w-full border-b border-gray-soft bg-transparent px-12 pb-8 pt-24 text-p-sm focus:border-blue focus:outline-none focus:ring-3 focus:ring-blue-light"
							name="message"
							rows="3"
							placeholder=" "
						></textarea>
						<span class="absolute left-12 top-[16px] -translate-y-12 flex items-center bg-white text-p-sm text-gray-medium transition-all duration-500 peer-placeholder-shown:translate-y-0 peer-focus:-translate-y-12">
							{form.messageLabel}
						</span>
					</label>
				</div>

				<div class="mb-8">
					<label class="flex cursor-pointer items-center gap-x-3.5 text-p-sm">
						<input class="sr-only" type="checkbox" />
						<span class="relative mr-8 py-[3px]">
							<span class="absolute left-0 top-0 h-18 w-18 rounded-full bg-gray-light shadow-[0_0_4px_0_rgba(0,0,0,0.25)]"></span>
							<span class="block h-[12px] w-[31px] rounded-3xl bg-gray-light"></span>
						</span>
						<span>
							{form.consent}{' '}
							<a class="text-blue underline" href={form.consentHref}>privacy policy</a>
							<span class="text-blue">*</span>
						</span>
					</label>
				</div>

				<span class="mt-24 flex flex-col items-stretch sm:flex-row sm:items-center sm:justify-end">
					<button
						type="submit"
						class="flex w-full items-center justify-center text-button appearance-none cursor-pointer rounded-pill bg-blue px-24 pt-[11px] pb-[12px] font-bold text-white transition-[background-color,color,border-color,box-shadow] duration-100 ease-out hover:bg-blue-dark3 sm:w-auto sm:min-w-[200px]"
					>
						{form.submit}
					</button>
				</span>
			</form>
		</div>
	</div>
</header>
