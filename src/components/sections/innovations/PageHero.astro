---
/**
 * PageHero — breadcrumb + H1 + lead + image of
 * `/product-solutions/innovations/`.
 *
 * 2026-11-25: the contact card that used to overlap the hero image has been
 * removed from this page. The hero is now a plain two-column band (copy +
 * one 5:4 photo), and the conversion point is the CTA row under the lead
 * plus the closing "Send Us the Joint" section.
 */
import type { BreadcrumbItem } from '@data/innovations';

interface Props {
	breadcrumb: BreadcrumbItem[];
	eyebrow: string;
	heading: string;
	lead: string;
	image: string;
	imageAlt: string;
	imageWidth: number;
	imageHeight: number;
	primaryCta: { label: string; href: string };
	secondaryCta: { label: string; href: string };
}

const {
	breadcrumb,
	eyebrow,
	heading,
	lead,
	image,
	imageAlt,
	imageWidth,
	imageHeight,
	primaryCta,
	secondaryCta,
} = Astro.props;
---

<header
	class="container-fluid mb-64 mt-40 flex flex-col wd:mb-72 wd:mt-48 wd:flex-row wd:items-center wd:gap-32 ul:mb-72 ul:mt-48"
>
	<div class="max-w-full wd:order-1 wd:grow-0 wd:self-center wd:w-1/2 wd:shrink-0 md:order-2">
		<nav
			class="opacity-1 mb-24 mt-8 overflow-hidden text-gray-medium transition-opacity duration-300 lg:mb-32 lg:mt-12"
			aria-label="Breadcrumb"
		>
			<ol class="flex text-p-l">
				<li class="flex items-center">
					<a href={breadcrumb[0].href} class="breadcrumb L0">
						<svg
							class="h-[16px] w-[16px] fill-gray-medium stroke-gray-medium stroke-[2]"
							aria-hidden="true"
						>
							<use href="/images/sprite.svg#home"></use>
						</svg>
						<span class="sr-only">{breadcrumb[0].label}</span>
					</a>
				</li>
				<li class="flex items-center">
					<svg
						class="h-[16px] w-[16px] inline-block fill-gray-medium stroke-gray-medium stroke-[1.75] mx-8 lg:mx-12"
						aria-hidden="true"
					>
						<use href="/images/sprite.svg#chevron-right"></use>
					</svg>
					<a href={breadcrumb[1].href} class="breadcrumb L1 whitespace-nowrap">
						{breadcrumb[1].label}
					</a>
				</li>
				<li class="flex-shrink-1 flex-grow-0 truncate whitespace-nowrap">
					<svg
						class="h-[16px] w-[16px] inline-block fill-gray-medium stroke-gray-medium stroke-[1.75] mx-8 lg:mx-12 mb-4"
						aria-hidden="true"
					>
						<use href="/images/sprite.svg#chevron-right"></use>
					</svg>
					<span>{breadcrumb[2].label}</span>
				</li>
			</ol>
		</nav>

		<p class="text-label mb-8 text-gray-medium lg:mb-12">{eyebrow}</p>
		<h1 class="text-h1 mb-24 hyphens-auto text-blue-dark3 lg:mb-32">{heading}</h1>
		<p class="text-lead mb-24 text-gray sm:mb-0">{lead}</p>

		<div class="mt-24 flex flex-wrap items-center gap-16 lg:mt-32">
			<a
				href={primaryCta.href}
				class="text-button appearance-none cursor-pointer rounded-pill bg-blue px-24 py-16 font-bold text-white transition-[background-color,color] duration-100 ease-out hover:bg-blue-dark3"
			>
				{primaryCta.label}
			</a>
			<a
				href={secondaryCta.href}
				class="text-button appearance-none cursor-pointer rounded-pill border-[1px] border-blue px-24 py-16 font-bold text-blue transition-[background-color,color,border-color] duration-100 ease-out hover:bg-blue hover:text-white"
			>
				{secondaryCta.label}
			</a>
		</div>
	</div>

	<div
		class="relative mb-24 md:mb-32 wd:order-2 wd:mb-0 wd:w-1/2 wd:shrink-0 wd:grow-0 order-1 sm:mt-24 md:order-1"
	>
		<figure class="flex w-full" data-ratio="1.25">
			<img
				src={image}
				alt={imageAlt}
				width={imageWidth}
				height={imageHeight}
				loading="eager"
				fetchpriority="high"
				class="aspect-5/4 object-cover flex-shrink-0 w-full rounded-tl-2xl rounded-tr-2xl md:rounded-2xl"
				style="aspect-ratio:5 / 4"
			/>
		</figure>
	</div>
</header>
