---
/**
 * RichText — 品类子页正文里的富文本段落（标题 / 段落 / 列表）。
 *
 * MEASURED on the reference (1440×1000, 2026-11-09):
 *   heading   44px #004975，pb-24 / lg:pb-32
 *   paragraph 20px/32 #333，pb-12 / lg:pb-20
 *   list      20px/36 #333，marker:text-blue，pl-[28px]
 *   宽度上限   782px（max-w-rich-text）
 */
import type { RichBlock } from '@data/category-detail/types';

interface Props {
	blocks: RichBlock[];
}

const { blocks } = Astro.props;
---

{
	blocks.map((block) =>
		block.kind === 'heading' ? (
			<div class="container-fluid">
				<h2 class="text-h3 pb-24 text-blue-dark3 max-w-rich-text lg:pb-32">{block.text}</h2>
			</div>
		) : block.kind === 'list' ? (
			<div class="container-fluid">
				<ul class="marker:text-blue pl-[28px] [&>li]:pl-8 list-disc max-w-rich-text text-list-l text-gray pb-12 lg:pb-20">
					{block.items.map((item) => (
						<li>
							<b>{item.lead}</b> {item.text}
						</li>
					))}
				</ul>
			</div>
		) : block.kind === 'table' ? (
			/* 介质/牌号对照矩阵：全宽紧凑表格（可横向滚动），不使用大图。 */
			<div class="container-fluid pb-12 lg:pb-20">
				{block.caption && <p class="mb-12 text-p-sm text-gray-medium lg:text-p-s">{block.caption}</p>}
				<div class="overflow-x-auto">
					<table class="w-full min-w-[760px] border-collapse text-left">
						<thead>
							<tr class="border-b border-gray-vlight">
								{block.columns.map((col) => (
									<th scope="col" class="py-12 pr-16 text-p-sm font-medium text-gray lg:text-p-s">
										{col}
									</th>
								))}
							</tr>
						</thead>
						<tbody>
							{block.rows.map((row) => (
								<tr class="border-b border-gray-vlight">
									{row.map((cell) => (
										<td class="py-12 pr-16 text-p-sm text-gray lg:text-p-s">{cell}</td>
									))}
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>
		) : (
			<div class="container-fluid">
				<p class="text-p pb-12 text-gray lg:pb-20 max-w-rich-text">
					{block.text}
					{block.link && (
						<>
							{' '}
							<a
								class="cursor-pointer text-blue underline focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-blue-dark"
								href={block.link.href}
							>
								{block.link.label}
							</a>
						</>
					)}
				</p>
			</div>
		),
	)
}
