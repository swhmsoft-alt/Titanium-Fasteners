---
/**
 * RichText — 品类子页正文里的富文本段落（标题 / 段落 / 列表）。
 *
 * MEASURED on the reference (1440×1000, 2026-11-09):
 *   heading   44px #004975，pb-24 / lg:pb-32
 *   paragraph 20px/32 #333，pb-12 / lg:pb-20
 *   list      20px/36 #333，marker:text-blue，pl-[28px]
 *   宽度上限   782px（max-w-rich-text）
 */
import type { RichBlock } from '@data/category-detail/types';

interface Props {
	blocks: RichBlock[];
}

const { blocks } = Astro.props;
---

{
	blocks.map((block) =>
		block.kind === 'heading' ? (
			<div class="container-fluid">
				<h2 class="text-h3 pb-24 text-blue-dark3 max-w-rich-text lg:pb-32">{block.text}</h2>
			</div>
		) : block.kind === 'list' ? (
			<div class="container-fluid">
				<ul class="marker:text-blue pl-[28px] [&>li]:pl-8 list-disc max-w-rich-text text-list-l text-gray pb-12 lg:pb-20">
					{block.items.map((item) => (
						<li>
							<b>{item.lead}</b> {item.text}
						</li>
					))}
				</ul>
			</div>
		) : (
			<div class="container-fluid">
				<p class="text-p pb-12 text-gray lg:pb-20 max-w-rich-text">{block.text}</p>
			</div>
		),
	)
}
