---
/**
 * PageHero — 品类子页的页头（面包屑 + eyebrow + H1 + lead + 双按钮 + 图）。
 *
 * MEASURED on the reference (1440×1000, 2026-11-09):
 *   breadcrumb   y=255  16px/25.6 #666
 *   eyebrow p    y=313  20px #666
 *   h1           y=353  64px/70.4 #004975  w=643
 *   buttons      y=757  49px 高（"View Products" 149×49 / "Contact Us" 140×49）
 *   hero figure  x=745 y=272 643×514（5:4）
 *
 * 12 个品类子页共用本组件，只有 data 不同。
 */
import type { Crumb, HeroButton } from '@data/category-detail/types';

interface Props {
	breadcrumb: Crumb[];
	eyebrow: string;
	heading: string;
	lead: string;
	image: string;
	imageAlt: string;
	imageWidth: number;
	imageHeight: number;
	buttons: HeroButton[];
}

const { breadcrumb, eyebrow, heading, lead, image, imageAlt, imageWidth, imageHeight, buttons } =
	Astro.props;

const BTN_BASE =
	'text-button appearance-none cursor-pointer transition-[box-shadow,border-color,background-color,color,text-decoration-color] ease-out duration-100 font-bold rounded-[28px] inline-block text-center px-24 pt-[11px] pb-[12px] lg:pt-[13px] lg:pb-[14px]';
const BTN_PRIMARY =
	'bg-blue text-white border-2 border-blue hover:bg-blue hover:border-blue-dark3 hover:ring-2 hover:ring-blue-dark3 hover:ring-offset-0 active:bg-blue-dark3 active:border-blue-dark3';
const BTN_SECONDARY =
	'bg-transparent text-blue-dark3 border-2 border-blue-dark3 hover:bg-transparent hover:text-blue hover:border-blue hover:ring-2 hover:ring-blue hover:ring-offset-0';
---

<header
	class="container-fluid mb-64 mt-40 flex flex-col wd:mb-72 wd:mt-48 wd:flex-row wd:items-center wd:gap-32 ul:mb-72 ul:mt-48"
>
	<div class="max-w-full wd:order-1 wd:grow-0 wd:self-center wd:w-1/2 wd:shrink-0 order-2">
		<nav
			class="opacity-100 mb-24 mt-8 overflow-hidden text-gray-medium transition-opacity duration-300 lg:mb-32 lg:mt-12"
			aria-label="Breadcrumb"
		>
			<ol class="flex text-h6-s">
				<li class="flex items-center">
					<a href={breadcrumb[0].href ?? '/'} class="breadcrumb L0">
						<svg
							class="h-[16px] w-[16px] fill-gray-medium stroke-gray-medium stroke-[2]"
							aria-hidden="true"
						>
							<use href="/images/sprite.svg#home"></use>
						</svg>
						<span class="sr-only">{breadcrumb[0].label}</span>
					</a>
				</li>
				<li class="flex items-center">
					<svg
						class="h-[16px] w-[16px] inline-block fill-gray-medium stroke-gray-medium stroke-[1.75] mx-8 lg:mx-12"
						aria-hidden="true"
					>
						<use href="/images/sprite.svg#chevron-right"></use>
					</svg>
					<button type="button" class="cursor-pointer text-gray-medium">
						{breadcrumb[1]?.label ?? '...'}
					</button>
				</li>
				<li class="flex-shrink-1 flex-grow-0 truncate whitespace-nowrap">
					<svg
						class="h-[16px] w-[16px] inline-block fill-gray-medium stroke-gray-medium stroke-[1.75] mx-8 lg:mx-12 mb-4"
						aria-hidden="true"
					>
						<use href="/images/sprite.svg#chevron-right"></use>
					</svg>
					<span>{breadcrumb[2]?.label ?? heading}</span>
				</li>
			</ol>
		</nav>

		<p class="text-label mb-8 text-gray-medium lg:mb-12">{eyebrow}</p>
		<h1 class="text-h1 mb-24 hyphens-auto text-blue-dark3 lg:mb-32">{heading}</h1>
		<p class="text-lead mb-24 text-gray sm:mb-0">{lead}</p>

		<section class="container-fluid ps-0 md:pt-32">
			<div class="flex gap-8 py-8">
				{
					buttons.map((btn) =>
						btn.kind === 'link' ? (
							<a
								class={`${BTN_BASE} ${btn.variant === 'primary' ? BTN_PRIMARY : BTN_SECONDARY}`}
								href={btn.href ?? '#'}
							>
								{btn.label}
							</a>
						) : (
							<a
								class={`${BTN_BASE} ${btn.variant === 'primary' ? BTN_PRIMARY : BTN_SECONDARY}`}
								href="/contact/"
							>
								{btn.label}
							</a>
						),
					)
				}
			</div>
		</section>
	</div>

	<div
		class="relative mb-24 md:mb-32 wd:order-2 wd:mb-0 wd:w-1/2 wd:shrink-0 wd:grow-0 order-1 sm:mt-0"
	>
		<figure class="flex w-full" data-ratio="1.25">
			<img
				src={image}
				alt={imageAlt}
				width={imageWidth}
				height={imageHeight}
				loading="eager"
				fetchpriority="high"
				class="aspect-5/4 flex-shrink-0 w-full rounded-2xl"
				style="aspect-ratio:5 / 4"
			/>
		</figure>
	</div>
</header>
