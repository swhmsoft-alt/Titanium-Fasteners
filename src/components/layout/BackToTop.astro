---
/**
 * BackToTop — the floating return-to-top button.
 *
 * MEASURED on the reference site:
 *   class     — group fixed bottom-24 right-24 z-50 flex h-48 w-48
 *               items-center justify-center rounded-full
 *   size      — 48×48px
 *   background— #ffffff
 *   aria-label— "Back to top"
 */
---

<button
	type="button"
	id="back-to-top"
	class="group fixed bottom-24 right-24 z-50 hidden h-48 w-48 items-center justify-center rounded-full bg-white text-blue-dark3 shadow-md transition-[opacity,transform,background-color] duration-300 ease-in-out hover:bg-blue-light"
	aria-label="Back to top"
>
	<svg
		class="h-24 w-24 transition-transform duration-300 group-hover:-translate-y-4"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="m18 15-6-6-6 6" />
	</svg>
</button>

<script>
	const button = document.getElementById('back-to-top');
	if (button) {
		const sync = () => {
			const visible = window.scrollY > 400;
			button.classList.toggle('hidden', !visible);
			button.classList.toggle('flex', visible);
		};
		window.addEventListener('scroll', sync, { passive: true });
		button.addEventListener('click', () => {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});
		sync();
	}
</script>
