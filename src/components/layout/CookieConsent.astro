---
/**
 * CookieConsent — a self-built consent banner.
 *
 * The reference site embeds a third-party cookie platform
 * (cdn.cookiehub.eu). We do NOT ship a third-party tracker: this is a
 * first-party banner that stores only the user's decision in localStorage
 * and sets no cookies of its own.
 *
 * The reference's CONSENT BUTTON is visually distinct from the site's main
 * button, and that difference is reproduced here:
 *   background #0070ba · border-radius 5px · font-size 15px
 * (the site's own `.text-button` uses #007ac3 / 28px radius / 18px)
 */
---

<div
	id="cookie-consent"
	class="fixed bottom-0 left-0 z-[250] hidden w-full border-t border-blue-light bg-white"
	role="dialog"
	aria-label="Cookie consent"
	aria-live="polite"
>
	<div class="container-reference py-24">
		<div class="flex flex-col gap-16 md:flex-row md:items-center md:justify-between md:gap-32">
			<div class="max-w-[782px]">
				<p class="text-p text-gray">
					We use essential cookies to operate this site. Optional analytics cookies help us
					improve it. You can accept all cookies or continue with essential cookies only.
				</p>
				<a
					href="/legal/privacy-policy/"
					class="text-label text-blue mt-8 inline-block underline underline-offset-4"
				>
					Privacy Policy
				</a>
			</div>

			<div class="flex shrink-0 gap-12">
				<button
					type="button"
					data-consent="essential"
					class="rounded-[5px] border border-blue-dark3 bg-transparent px-16 py-8 text-[15px] leading-none text-blue-dark3 transition-colors duration-300 hover:bg-blue-light"
				>
					Essential only
				</button>
				<button
					type="button"
					data-consent="all"
					class="rounded-[5px] border border-blue-primary bg-blue-primary px-16 py-8 text-[15px] leading-none text-white transition-colors duration-300 hover:bg-blue-dark3"
				>
					Accept all
				</button>
			</div>
		</div>
	</div>
</div>

<script>
	const STORAGE_KEY = 'tf-cookie-consent';
	const banner = document.getElementById('cookie-consent');

	if (banner) {
		const stored = window.localStorage.getItem(STORAGE_KEY);
		if (!stored) {
			banner.classList.remove('hidden');
		}

		for (const button of banner.querySelectorAll('[data-consent]')) {
			button.addEventListener('click', () => {
				window.localStorage.setItem(
					STORAGE_KEY,
					button.getAttribute('data-consent') ?? 'essential',
				);
				banner.classList.add('hidden');
			});
		}
	}
</script>
