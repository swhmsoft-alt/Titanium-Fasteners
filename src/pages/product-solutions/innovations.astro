---
/**
 * /product-solutions/innovations/
 * Reference: https://www.bossard.com/global-en/product-solutions/innovations/
 *
 * MEASURED on the reference (1440×1000, 2026-11-10):
 *   hero      figure x=745 y=267 643×514 | contact card x=920 w=362, submit y=1079
 *   intro     2 × container-fluid rich-text paragraphs
 *   carousel  "Our Fastening Innovations" — 5 cards, 316 wide, y=1277
 *   article   "What We Offer You"  y=2187 h=512  (grid y=2260, 3 cols × 2 rows)
 *   cta       "Contact Us" button y=2892 x=70 140×49
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SiteHeader from '@components/layout/SiteHeader.astro';
import MegaMenu from '@components/layout/MegaMenu.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import CookieConsent from '@components/layout/CookieConsent.astro';
import BackToTop from '@components/layout/BackToTop.astro';
import PageHero from '@components/sections/innovations/PageHero.astro';
import InnovationsCarousel from '@components/sections/innovations/InnovationsCarousel.astro';
import OfferGrid from '@components/sections/innovations/OfferGrid.astro';
import NextStepCta from '@components/sections/innovations/NextStepCta.astro';
import { INNOVATIONS as PAGE } from '@data/innovations';

const currentPathname = Astro.url.pathname;
---

<BaseLayout
	title={PAGE.seo.title}
	description={PAGE.seo.description}
	canonicalPath="/product-solutions/innovations/"
>
	<SiteHeader currentPathname={currentPathname} />
	<MegaMenu />

	<main id="main" class="pt-48 md:pt-91">
		<PageHero {...PAGE.hero} form={PAGE.form} />

		{
			PAGE.intro.map((para) => (
				<div class="container-fluid">
					<p class="text-p pb-12 text-gray lg:pb-20 max-w-rich-text">{para}</p>
				</div>
			))
		}

		<div>
			<InnovationsCarousel
				heading={PAGE.innovations.heading}
				items={PAGE.innovations.items}
			/>
		</div>

		<div class="container-fluid">
			<h2 class="text-h3 pb-24 text-blue-dark3 max-w-rich-text lg:pb-32">
				{PAGE.yourInnovation.heading}
			</h2>
		</div>
		{
			PAGE.yourInnovation.paragraphs.map((para) => (
				<div class="container-fluid">
					<p class="text-p pb-12 text-gray lg:pb-20 max-w-rich-text">{para}</p>
				</div>
			))
		}

		<OfferGrid heading={PAGE.offers.heading} items={PAGE.offers.items} />

		<div>
			<NextStepCta {...PAGE.nextStep} />
		</div>

		<div class="container-fluid">
			<p class="text-p pb-12 text-gray lg:pb-20 max-w-rich-text"></p>
		</div>
		<div class="container-fluid">
			<p class="text-p pb-12 text-gray lg:pb-20 max-w-rich-text"></p>
		</div>
	</main>

	<SiteFooter />
	<CookieConsent />
	<BackToTop />
</BaseLayout>
