---
/**
 * Homepage — BOZE Titanium Fasteners.
 *
 * READ ORDER (nine screens, one job each)
 * ---------------------------------------
 *   1  HeroSection          identity + the two conversion doors
 *   2  SpecFinderSection    digital standard selection (distributor first)
 *   3  CapabilitiesSection  the three factory assets
 *   4  AudienceSplitSection distributor vs OEM
 *   5  ProductMatrixSection the real published product families
 *   6  MaterialsSection     grade table (nominal published values)
 *   7  ComplianceSection    the quality loop, three layers
 *   8  TrustSection         Who / How / Why transparency
 *   9  ClosingCtaSection    bottom conversion
 *
 * SCOPE
 * -----
 * Only this page and src/components/sections/home/* plus src/data/home.ts
 * were changed. The global stylesheet, BaseLayout, SiteHeader, MegaMenu,
 * SiteFooter and the inquiry island are untouched.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SiteHeader from '@components/layout/SiteHeader.astro';
import MegaMenu from '@components/layout/MegaMenu.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import CookieConsent from '@components/layout/CookieConsent.astro';
import BackToTop from '@components/layout/BackToTop.astro';
import { SITE } from '@config/site';

import HeroSection from '@components/sections/home/HeroSection.astro';
import SpecFinderSection from '@components/sections/home/SpecFinderSection.astro';
import CapabilitiesSection from '@components/sections/home/CapabilitiesSection.astro';
import AudienceSplitSection from '@components/sections/home/AudienceSplitSection.astro';
import ProductMatrixSection from '@components/sections/home/ProductMatrixSection.astro';
import MaterialsSection from '@components/sections/home/MaterialsSection.astro';
import ComplianceSection from '@components/sections/home/ComplianceSection.astro';
import TrustSection from '@components/sections/home/TrustSection.astro';
import ClosingCtaSection from '@components/sections/home/ClosingCtaSection.astro';

const currentPathname = Astro.url.pathname;

const description =
	'Titanium fastener factory: M1.6–M36 in CP Grade 2 and Grade 5 Ti-6Al-4V, ' +
	'to DIN, ISO, ASTM F467 / F468 and ASME. EN 10204 3.1 MTC per lot, PMI / XRF ' +
	'before packing, NDA-protected print-to-part CNC.';

/**
 * Structured data — Organization + WebSite + ItemList of the catalogue.
 * No FAQPage: this page carries no question-and-answer pairs.
 */
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		'@id': `${SITE.url}/#organization`,
		name: SITE.name,
		legalName: SITE.legalName,
		url: SITE.url,
		description,
		email: 'info@bozemetal.com',
		address: {
			'@type': 'PostalAddress',
			streetAddress:
				'C4 Workshop, North Area of High Tech Auto Parts, Business Incubation Base, FengHuang 10th Road, High Tech Development Zone',
			addressLocality: 'Baoji',
			addressRegion: 'Shaanxi',
			postalCode: '721013',
			addressCountry: 'CN',
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		'@id': `${SITE.url}/#website`,
		url: SITE.url,
		name: SITE.name,
		publisher: { '@id': `${SITE.url}/#organization` },
		inLanguage: SITE.locale,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		name: 'Titanium Fastener Product Range',
		itemListElement: [
			{ label: 'Screws', href: '/products/screws/' },
			{ label: 'Bolts', href: '/products/bolts/' },
			{ label: 'Nuts', href: '/products/nuts/' },
			{ label: 'Washers', href: '/products/washers/' },
		].map((item, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: item.label,
			url: new URL(item.href, SITE.url).href,
		})),
	},
];
---

<BaseLayout
	title="Titanium Fasteners to DIN, ISO, ASTM F467 / F468 and ASME — M1.6–M36, CP Grade 2 and Grade 5 Ti-6Al-4V"
	description={description}
	canonicalPath="/"
	jsonLd={jsonLd}
>
	<SiteHeader currentPathname={currentPathname} />
	<MegaMenu />

	<!--
		pt-48 md:pt-91 clears the fixed header and nothing more. The reference's
		extra 195px lead-in band is not reproduced — the hero starts directly
		below the navigation.
	-->
	<main id="main" class="pt-48 md:pt-91">
		<HeroSection />
		<SpecFinderSection />
		<CapabilitiesSection />
		<AudienceSplitSection />
		<ProductMatrixSection />
		<MaterialsSection />
		<ComplianceSection />
		<TrustSection />
		<ClosingCtaSection />
	</main>

	<SiteFooter />
	<CookieConsent />
	<BackToTop />
</BaseLayout>
