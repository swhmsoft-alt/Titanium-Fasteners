---
/**
 * /services/ — 服务主干页（四大主题）。
 *
 * STRUCTURE
 * ---------
 *   Hero（面包屑 + eyebrow + h1 + lead）
 *   → 定位声明（intro）
 *   → ① 综合服务能力  ServiceFeature（左图右文）
 *   → ② 工艺加工能力  ServiceFeature（右图左文）
 *   → ③ 履约交付能力  ServiceFeature（左图右文）
 *   → ④ 质检质量保证  ServiceFeature（右图左文）
 *   → Who / How / Why 透明度声明
 *   → CTA（→ /contact/）
 *
 * DATA
 * ----
 * 全部文案与链接来自 src/data/services.ts —— 那是本页的唯一数据源，
 * 其内容只派生自 src/data/about-us.ts 与 src/data/services-sub/capabilities.ts
 * 的既有事实（无通用科普、无未提供的实测数据）。
 *
 * CHANGES VS THE PREVIOUS VERSION
 * -------------------------------
 * 旧版是参考站（Bossard）的 1:1 照抄：SEO title 带 `Bossard Group`，
 * 四张图卡指向 Smart Factory / Engineering，五张利益点卡指向 TCO 与设计验证，
 * 尾部是参考站的「工厂蓝图」。本轮全部替换为自有品牌与四大主题口径。
 * 菜单（src/config/site.ts → NAVIGATION → Services）本轮**未动**。
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SiteHeader from '@components/layout/SiteHeader.astro';
import MegaMenu from '@components/layout/MegaMenu.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import CookieConsent from '@components/layout/CookieConsent.astro';
import BackToTop from '@components/layout/BackToTop.astro';
import ServiceFeature from '@components/sections/services/ServiceFeature.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import RichText from '@components/ui/RichText.astro';
import Button from '@components/ui/Button.astro';
import { SERVICES as PAGE } from '@data/services';
import { SITE } from '@config/site';

const currentPathname = Astro.url.pathname;
const { breadcrumb, eyebrow, heading, lead } = PAGE.hero;

/**
 * JSON-LD —— 单个 @graph 承载 CollectionPage + Organization + BreadcrumbList。
 *
 * 与 /contact/ 同一写法（BaseLayout 把 jsonLd 整个 JSON.stringify 成一个 <script>）。
 * 这里描述的是一个「服务集合页」，因此用 CollectionPage 而不是 WebPage。
 */
const orgId = `${SITE.url}/#organization`;
const pageUrl = new URL('/services/', SITE.url).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': orgId,
			name: SITE.name,
			legalName: SITE.legalName,
			url: SITE.url,
			description:
				'Manufacturer of titanium fasteners — bolts, screws, studs, nuts and washers to DIN and ISO, M1.6–M36, produced in-house with EN 10204 3.1 certification.',
		},
		{
			'@type': 'CollectionPage',
			name: PAGE.seo.title,
			description: PAGE.seo.description,
			url: pageUrl,
			inLanguage: 'en',
			mainEntity: { '@id': orgId },
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
				{ '@type': 'ListItem', position: 2, name: 'Services', item: pageUrl },
			],
		},
	],
};
---

<BaseLayout
	title={PAGE.seo.title}
	description={PAGE.seo.description}
	canonicalPath="/services/"
	jsonLd={jsonLd}
>
	<SiteHeader currentPathname={currentPathname} />
	<MegaMenu />

	<main id="main" class="pt-48 md:pt-91">
		<header
			class="container-fluid mb-64 mt-40 flex flex-col wd:mb-72 wd:mt-48 wd:flex-row wd:items-center wd:gap-32 ul:mb-72 ul:mt-48"
		>
			<div class="max-w-full wd:order-1 wd:grow-0 wd:self-center order-2">
				<nav
					class="opacity-100 mb-24 mt-8 overflow-hidden text-gray-medium transition-opacity duration-300 lg:mb-32 lg:mt-12"
					aria-label="Breadcrumb"
				>
					<ol class="flex text-h6-s">
						<li class="flex items-center">
							<a href={breadcrumb[0].href} class="breadcrumb L0">
								<svg
									class="h-[16px] w-[16px] fill-gray-medium stroke-gray-medium stroke-[2]"
									aria-hidden="true"
								>
									<use href="/images/sprite.svg#home"></use>
								</svg>
								<span class="sr-only">{breadcrumb[0].label}</span>
							</a>
						</li>
						<li class="flex-shrink-1 flex-grow-0 truncate whitespace-nowrap">
							<svg
								class="h-[16px] w-[16px] inline-block fill-gray-medium stroke-gray-medium stroke-[1.75] mx-8 lg:mx-12 mb-4"
								aria-hidden="true"
							>
								<use href="/images/sprite.svg#chevron-right"></use>
							</svg>
							<span aria-current="page">{breadcrumb[1].label}</span>
						</li>
					</ol>
				</nav>

				<p class="text-label mb-8 text-gray-medium lg:mb-12">{eyebrow}</p>
				<h1 class="text-h1 mb-24 hyphens-auto text-blue-dark3 lg:mb-32">{heading}</h1>
				<p class="text-lead mb-24 text-gray sm:mb-0">{lead}</p>
			</div>
		</header>

		{/* 定位声明 */}
		<div class="container-fluid">
			<RichText class="mb-32 lg:mb-48">
				<p class="pb-12 text-gray lg:pb-20">{PAGE.intro}</p>
			</RichText>
		</div>

		{/* 四大主题 —— 左右交替 */}
		{
			PAGE.themes.map((theme) => (
				<ServiceFeature theme={theme} cta={{ label: PAGE.cta.label, href: PAGE.cta.href }} />
			))
		}

		{/* Who / How / Why —— 透明度声明，纯静态可读 */}
		<section class="container-fluid py-32 lg:py-48">
			<SectionHeading size="h3" as="h2" class="mb-24 lg:mb-32">
				{PAGE.transparency.heading}
			</SectionHeading>
			<div class="grid grid-cols-1 gap-24 md:grid-cols-3 lg:gap-32">
				{
					PAGE.transparency.items.map((item) => (
						<section class="rounded-lg border border-blue-70 p-16 lg:p-24">
							<p class="text-label mb-8 text-blue-dark3">{item.label}</p>
							<h3 class="text-h5 mb-12 text-blue-dark3">{item.heading}</h3>
							<p class="text-p-sm text-gray">{item.body}</p>
						</section>
					))
				}
			</div>
		</section>

		{/* CTA —— 指向已存在的 /contact/ 路由 */}
		<section class="container-fluid pb-48 lg:pb-56">
			<div class="rounded-lg border border-blue-light p-24 lg:p-48">
				<SectionHeading size="h4" as="h2" class="mb-12 lg:mb-16">
					{PAGE.cta.heading}
				</SectionHeading>
				<p class="mb-32 max-w-[720px] text-p text-gray">{PAGE.cta.body}</p>
				<Button href={PAGE.cta.href}>{PAGE.cta.label}</Button>
			</div>
		</section>

		{/* 次级出口 —— 全部是已存在的真实路由 */}
		<section class="container-fluid pb-48 lg:pb-56">
			<h2 class="text-h4 mb-16 text-blue-dark3 lg:mb-24">Related information</h2>
			<ul class="flex flex-wrap gap-16 lg:gap-24">
				{
					PAGE.secondaryLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class="inline-flex items-center rounded-pill border-2 border-blue-dark3 px-24 py-13 pb-14 text-button text-blue-dark3 transition-colors duration-300 hover:bg-blue-dark3 hover:text-white"
							>
								{link.label}
								<svg class="ml-8 h-16 w-16 stroke-blue-dark3" aria-hidden="true">
									<use href="/images/sprite.svg#arrow-right"></use>
								</svg>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>

	<SiteFooter />
	<CookieConsent />
	<BackToTop />
</BaseLayout>
