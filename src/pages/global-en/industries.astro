---
/**
 * /global-en/industries/
 * Reference: https://www.bossard.com/global-en/industries/
 *
 * MEASURED on the reference (1440×1000, 2026-11-10):
 *   hero     breadcrumb y=255 | label y=313 20px | h1 y=353 64px #004975
 *            lead 24px — the hero is TEXT ONLY (no image on this page)
 *   block 1  Aerospace                  y=604  h=865  H2 32px
 *   block 2  Electric Vehicles          y=1469 h=865  H2 32px
 *   block 3  Medical and Life Science   y=2335 h=865  H2 32px
 *   block 4  Robotics                   y=3200 h=865  H2 32px
 *   block 5  Data Centers               y=4065 h=913  H2 44px  bg #ffffff
 *
 * The reference's <main> holds the hero <header>, four <article> card grids,
 * the Data Centers <article> and the contact <section>.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SiteHeader from '@components/layout/SiteHeader.astro';
import MegaMenu from '@components/layout/MegaMenu.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import CookieConsent from '@components/layout/CookieConsent.astro';
import BackToTop from '@components/layout/BackToTop.astro';
import IndustryCards from '@components/sections/industries/IndustryCards.astro';
import DataCentersCallout from '@components/sections/industries/DataCentersCallout.astro';
import IndustryContact from '@components/sections/industries/IndustryContact.astro';
import { INDUSTRIES as PAGE } from '@data/industries';

const currentPathname = Astro.url.pathname;
const { breadcrumb, eyebrow, heading, lead } = PAGE.hero;
---

<BaseLayout
	title={PAGE.seo.title}
	description={PAGE.seo.description}
	canonicalPath="/global-en/industries/"
>
	<SiteHeader currentPathname={currentPathname} />
	<MegaMenu />

	<main id="main" class="pt-48 md:pt-91">
		<header
			class="container-fluid mb-64 mt-40 flex flex-col wd:mb-72 wd:mt-48 wd:flex-row wd:items-center wd:gap-32 ul:mb-72 ul:mt-48"
		>
			<div class="max-w-full wd:order-1 wd:grow-0 wd:self-center order-2">
				<nav
					class="opacity-1 mb-24 mt-8 overflow-hidden text-gray-medium transition-opacity duration-300 lg:mb-32 lg:mt-12"
					aria-label="Breadcrumb"
				>
					<ol class="flex text-h6-s">
						<li class="flex items-center">
							<a href={breadcrumb[0].href} class="breadcrumb L0">
								<svg
									class="h-[16px] w-[16px] fill-gray-medium stroke-gray-medium stroke-[2]"
									aria-hidden="true"
								>
									<use href="/images/sprite.svg#home"></use>
								</svg>
								<span class="sr-only">{breadcrumb[0].label}</span>
							</a>
						</li>
						<li class="flex-shrink-1 flex-grow-0 truncate whitespace-nowrap">
							<svg
								class="h-[16px] w-[16px] inline-block fill-gray-medium stroke-gray-medium stroke-[1.75] mx-8 lg:mx-12 mb-4"
								aria-hidden="true"
							>
								<use href="/images/sprite.svg#chevron-right"></use>
							</svg>
							<span>{breadcrumb[1].label}</span>
						</li>
					</ol>
				</nav>

				<p class="text-label mb-8 text-gray-medium lg:mb-12">{eyebrow}</p>
				<h1 class="text-h1 mb-24 hyphens-auto text-blue-dark3 lg:mb-32">{heading}</h1>
				<p class="text-lead mb-24 text-gray sm:mb-0">{lead}</p>
			</div>
		</header>

		<IndustryCards cards={PAGE.cards.slice(0, 2)} />
		<IndustryCards cards={PAGE.cards.slice(2, 4)} />
		<IndustryCards cards={PAGE.cards.slice(4, 6)} />
		<IndustryCards cards={PAGE.cards.slice(6, 8)} />

		<DataCentersCallout dataCenters={PAGE.dataCenters} />

		<IndustryContact contact={PAGE.contact} />
	</main>

	<SiteFooter />
	<CookieConsent />
	<BackToTop />
</BaseLayout>
