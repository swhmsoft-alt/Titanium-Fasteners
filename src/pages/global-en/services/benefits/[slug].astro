---
/**
 * /global-en/services/benefits/<slug>/
 *
 * The five benefit pages share this template — each one only differs in its
 * data file (src/data/services-detail/benefits-<slug>.ts, generated by
 * scripts/gen-services-detail.mjs).
 *
 * MEASURED on the reference (1440×1000, 2026-11-10,
 * /global-en/services/benefits/cost-saving-rationalization/):
 *   body 3743px, footer 517px, h-overflow 0px
 *   hero    breadcrumb y=255 | label y=313 | h1 y=353 | lead 24px/38.4
 *   step 1  y= 688 h=516   H2 21.008px
 *   step 2  y=1204 h=516
 *   step 3  y=1720 h=516
 *   CTA     y=2237 h=969   H2 44px
 *
 * The reference's <main> order: hero header → intro paragraph → one
 * "copy-text-image" article per step → the TCO callout article.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SiteHeader from '@components/layout/SiteHeader.astro';
import MegaMenu from '@components/layout/MegaMenu.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import CookieConsent from '@components/layout/CookieConsent.astro';
import BackToTop from '@components/layout/BackToTop.astro';
import ServiceHero from '@components/sections/services-detail/ServiceHero.astro';
import ServiceStep from '@components/sections/services-detail/ServiceStep.astro';
import TcoCallout from '@components/sections/services-detail/TcoCallout.astro';
import { BENEFIT_SLUGS, BENEFIT_PAGES } from '@data/services-detail/index';

export function getStaticPaths() {
	return BENEFIT_SLUGS.map((slug) => ({
		params: { slug },
		props: { page: BENEFIT_PAGES[slug] },
	}));
}

const { page } = Astro.props;
const currentPathname = Astro.url.pathname;
const canonicalPath = `/global-en/services/benefits/${currentPathname.split('/').pop()}/`;
---

<BaseLayout title={page.seo.title} description={page.seo.description} canonicalPath={canonicalPath}>
	<SiteHeader currentPathname={currentPathname} />
	<MegaMenu />

	<main id="main" class="pt-48 md:pt-91">
		<ServiceHero {...page.hero} />

		{
			page.intro && (
				<div class="container-fluid">
					<p class="text-p pb-12 text-gray lg:pb-20 max-w-rich-text">
						{page.intro.before}
							{page.intro.strong && <strong>{page.intro.strong}</strong>}
							{page.intro.after}
					</p>
				</div>
			)
		}

		{page.steps.map((step) => <ServiceStep step={step} />)}

		{page.cta && <TcoCallout cta={page.cta} />}

		<div class="container-fluid">
			<p class="text-p pb-12 text-gray lg:pb-20 max-w-rich-text"></p>
		</div>
	</main>

	<SiteFooter />
	<CookieConsent />
	<BackToTop />
</BaseLayout>
