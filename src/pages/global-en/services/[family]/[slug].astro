---
/**
 * /global-en/services/<family>/<slug>/ — the four CMS-style service sub-pages.
 *
 * Reference: https://www.bossard.com/global-en/services/...
 *   inventory-management      /smart-factory/inventory-management/
 *   smart-assembly            /smart-factory/smart-assembly/
 *   fastening-composites      /engineering/fastening-composites/
 *   engineering-services      /engineering/engineering-services/
 *
 * MEASURED on the reference (1440×1000, 2026-11-10):
 *   body 7738–9370px, footer 517px, h-overflow 0px
 *   hero  breadcrumb y=255 | eyebrow y=313 20px | h1 y=353 64px/70.4 #004975
 *
 * The page body is a CMS block composition; the block list comes from
 * src/data/services-sub/<slug>.ts and is rendered by ServiceBlocks.astro.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SiteHeader from '@components/layout/SiteHeader.astro';
import MegaMenu from '@components/layout/MegaMenu.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import CookieConsent from '@components/layout/CookieConsent.astro';
import BackToTop from '@components/layout/BackToTop.astro';
import ServiceHero from '@components/sections/services-detail/ServiceHero.astro';
import ServiceBlocks from '@components/sections/services-sub/ServiceBlocks.astro';
import { PAGE as inventoryManagement } from '@data/services-sub/smart-factory-inventory-management';
import { PAGE as smartAssembly } from '@data/services-sub/smart-factory-smart-assembly';
import { PAGE as fasteningComposites } from '@data/services-sub/engineering-fastening-composites';
import { PAGE as engineeringServices } from '@data/services-sub/engineering-engineering-services';

type SubPage = typeof inventoryManagement;

export function getStaticPaths() {
	return [
		{
			params: { family: 'smart-factory', slug: 'inventory-management' },
			props: { page: inventoryManagement },
		},
		{
			params: { family: 'smart-factory', slug: 'smart-assembly' },
			props: { page: smartAssembly },
		},
		{
			params: { family: 'engineering', slug: 'fastening-composites' },
			props: { page: fasteningComposites },
		},
		{
			params: { family: 'engineering', slug: 'engineering-services' },
			props: { page: engineeringServices },
		},
	];
}

interface Props {
	page: SubPage;
}

const { page } = Astro.props as Props;
const currentPathname = Astro.url.pathname;
---

<BaseLayout
	title={page.seo.title}
	description={page.seo.description}
	canonicalPath={`/global-en/services/${page.path}/`}
>
	<SiteHeader currentPathname={currentPathname} />
	<MegaMenu />

	<main id="main" class="pt-48 md:pt-91">
		<ServiceHero
			breadcrumb={page.hero.breadcrumb}
			eyebrow={page.hero.eyebrow}
			heading={page.hero.heading}
			lead={page.hero.lead}
		/>

		<ServiceBlocks blocks={page.blocks} />
	</main>

	<SiteFooter />
	<CookieConsent />
	<BackToTop />
</BaseLayout>
