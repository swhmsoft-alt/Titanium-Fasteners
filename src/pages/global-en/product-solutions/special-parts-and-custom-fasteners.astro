---
/**
 * /global-en/product-solutions/special-parts-and-custom-fasteners/
 * Reference: https://www.bossard.com/global-en/product-solutions/special-parts-and-custom-fasteners/
 *
 * MEASURED on the reference (1440×1000, 2026-11-09):
 *   body 6089px, footer 517px, h-overflow 0px
 *   block 1  Why You Should Procure …        y=892  h=561  h2 44px
 *   block 2  Our Technological Capabilities   y=2121 h=386  h2 44px
 *   block 4  Functional Coatings …            y=2819 h=386  h2 44px
 *   block 8  Other Custom Services            y=3433 h=273  h2 44px
 *   block 10 Bossard Special Parts Brochure   y=5336 h=144  h3 21.008px
 *
 * 数据来自 src/data/special-parts.ts（由 scripts/gen-special-parts.mjs 生成）。
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SiteHeader from '@components/layout/SiteHeader.astro';
import MegaMenu from '@components/layout/MegaMenu.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import CookieConsent from '@components/layout/CookieConsent.astro';
import BackToTop from '@components/layout/BackToTop.astro';
import PageHero from '@components/sections/special-parts/PageHero.astro';
import BenefitsGrid from '@components/sections/special-parts/BenefitsGrid.astro';
import IntroBlocks from '@components/sections/special-parts/IntroBlocks.astro';
import AccordionGroup from '@components/sections/special-parts/AccordionGroup.astro';
import ImageRail from '@components/sections/special-parts/ImageRail.astro';
import FinishNote from '@components/sections/special-parts/FinishNote.astro';
import ContactCta from '@components/sections/special-parts/ContactCta.astro';
import Brochure from '@components/sections/special-parts/Brochure.astro';
import { SPECIAL_PARTS as PAGE } from '@data/special-parts';

const currentPathname = Astro.url.pathname;
---

<BaseLayout
	title={PAGE.seo.title}
	description={PAGE.seo.description}
	canonicalPath="/global-en/product-solutions/special-parts-and-custom-fasteners/"
>
	<SiteHeader currentPathname={currentPathname} />
	<MegaMenu />

	<main id="main" class="pt-48 md:pt-91">
		<PageHero {...PAGE.hero} />

		<BenefitsGrid heading={PAGE.benefits.heading} cards={PAGE.benefits.cards} />

		<IntroBlocks
			paragraph={PAGE.intro.paragraph}
			list={PAGE.intro.list}
			closing={PAGE.intro.closing}
		/>

		<AccordionGroup heading={PAGE.tech.heading} items={PAGE.tech.items} variant="text" />

		<ImageRail
			slides={PAGE.rail1.slides}
			thumbs={PAGE.rail1.thumbs}
			dialogImage={PAGE.rail1.dialog.image}
			dialogCaption={PAGE.rail1.dialog.caption}
		/>

		<AccordionGroup heading={PAGE.coatings.heading} items={PAGE.coatings.items} variant="media" />

		<FinishNote heading={PAGE.finish.heading} cta={PAGE.finish.cta} />

		<AccordionGroup heading={PAGE.services.heading} items={PAGE.services.items} variant="text" />

		<ImageRail
			slides={PAGE.rail2.slides}
			thumbs={PAGE.rail2.thumbs}
			dialogImage={PAGE.rail2.dialog.image}
			dialogCaption={PAGE.rail2.dialog.caption}
		/>

		<ContactCta
			heading={PAGE.cta.heading}
			text={PAGE.cta.text}
			image={PAGE.cta.image}
			form={PAGE.cta.form}
		/>

		<Brochure
			title={PAGE.brochure.title}
			text={PAGE.brochure.text}
			thumb={PAGE.brochure.thumb}
			file={PAGE.brochure.file}
		/>
	</main>

	<SiteFooter />
	<CookieConsent />
	<BackToTop />
</BaseLayout>
