---
/**
 * /global-en/product-solutions/components-specific-solutions/fastener-coatings/
 * Reference: https://www.bossard.com/global-en/product-solutions/components-specific-solutions/fastener-coatings/
 *
 * MEASURED on the reference (1440×1000, 2026-11-09):
 *   body 4261px, footer 517px, h-overflow 0px
 *   hero      img 643×514 at x=745 | H1 64px/70.4 #004975 x=70
 *   intro     4 × container-fluid rich-text paragraphs (3 filled + 1 empty)
 *   block 1   Different Types of Fastener Coatings  y=1197 h=938  H2 44px
 *   block 2   Corrosion Protection Coatings         y=2135 h=961  H2 44px
 *   block 3   Learn More About Fastener Coatings    y=3144 h=508  H2 44px
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SiteHeader from '@components/layout/SiteHeader.astro';
import MegaMenu from '@components/layout/MegaMenu.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import CookieConsent from '@components/layout/CookieConsent.astro';
import BackToTop from '@components/layout/BackToTop.astro';
import PageHero from '@components/sections/fastener-coatings/PageHero.astro';
import CoatingTypes from '@components/sections/fastener-coatings/CoatingTypes.astro';
import CorrosionCallout from '@components/sections/fastener-coatings/CorrosionCallout.astro';
import WhitePapers from '@components/sections/fastener-coatings/WhitePapers.astro';
import { FASTENER_COATINGS as PAGE } from '@data/fastener-coatings';

const currentPathname = Astro.url.pathname;
---

<BaseLayout
	title={PAGE.seo.title}
	description={PAGE.seo.description}
	canonicalPath="/global-en/product-solutions/components-specific-solutions/fastener-coatings/"
>
	<SiteHeader currentPathname={currentPathname} />
	<MegaMenu />

	<main id="main" class="pt-48 md:pt-91">
		<PageHero {...PAGE.hero} />

		{
			PAGE.intro.map((para) => (
				<div class="container-fluid">
					<p class="text-p pb-12 text-gray lg:pb-20 max-w-rich-text">
						{para.strong && <strong>{para.strong}</strong>}
						{para.text}
					</p>
				</div>
			))
		}

		<CoatingTypes heading={PAGE.types.heading} cards={PAGE.types.cards} />

		<CorrosionCallout callout={PAGE.corrosion} />

		<WhitePapers
			heading={PAGE.papers.heading}
			label={PAGE.papers.label}
			items={PAGE.papers.items}
		/>

		<div class="container-fluid">
			<p class="text-p pb-12 text-gray lg:pb-20 max-w-rich-text"></p>
		</div>
	</main>

	<SiteFooter />
	<CookieConsent />
	<BackToTop />
</BaseLayout>
