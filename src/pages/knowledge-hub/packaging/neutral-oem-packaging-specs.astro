---
/**
 * /knowledge-hub/packaging/neutral-oem-packaging-specs/
 *
 * 中性包装 / OEM 包装规格页 —— **参数型**：只讲「包装长什么样、印什么、
 * 需要客户提供哪些标签数据」，不承诺服务执行。
 *
 * 与 Services 栏的 `Distributor Labeling & Packaging` 分工：
 *   本页 = 规格参数（查表、看要准备什么）
 *   服务页 = 服务承诺（贴标怎么执行、保密怎么控、出口怎么保护）
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SiteHeader from '@components/layout/SiteHeader.astro';
import MegaMenu from '@components/layout/MegaMenu.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import CookieConsent from '@components/layout/CookieConsent.astro';
import BackToTop from '@components/layout/BackToTop.astro';
import KnowledgeHubHero from '@components/sections/knowledge-hub/KnowledgeHubHero.astro';
import KnowledgeHubFacts from '@components/sections/knowledge-hub/KnowledgeHubFacts.astro';
import AboutUsCta from '@components/sections/about-us/AboutUsCta.astro';
import { PACKAGING_SPECS_PAGE } from '@data/knowledge-hub';

const currentPathname = Astro.url.pathname;
---

<BaseLayout
	title={PACKAGING_SPECS_PAGE.seo.title}
	description={PACKAGING_SPECS_PAGE.seo.description}
	canonicalPath={PACKAGING_SPECS_PAGE.path}
>
	<SiteHeader currentPathname={currentPathname} />
	<MegaMenu />

	<main id="main" class="pt-48 md:pt-91">
		<KnowledgeHubHero {...PACKAGING_SPECS_PAGE.hero} />

		{
			PACKAGING_SPECS_PAGE.body.map((paragraph) => (
				<div class="container-fluid">
					<p class="text-p pb-12 text-gray lg:pb-20 max-w-rich-text">{paragraph}</p>
				</div>
			))
		}

		{
			PACKAGING_SPECS_PAGE.specTable && (
				<section class="container-fluid pb-48 pt-32 lg:pb-56 lg:pt-40">
					<h2 class="text-h3 mb-16 text-blue-dark3 lg:mb-24">
						{PACKAGING_SPECS_PAGE.specTable.heading}
					</h2>
					<p class="mb-24 text-p text-gray max-w-rich-text">
						{PACKAGING_SPECS_PAGE.specTable.lead}
					</p>

					<div class="overflow-x-auto">
						<table class="w-full min-w-[820px] border-collapse text-left">
							<caption class="sr-only">
								Neutral, OEM and export packing compared attribute by attribute
							</caption>
							<thead>
								<tr class="border-b border-gray-vlight">
									{PACKAGING_SPECS_PAGE.specTable.columns.map((column, index) => (
										<th
											scope="col"
											class:list={[
												'py-12 text-p-sm font-medium text-gray',
												index < PACKAGING_SPECS_PAGE.specTable.columns.length - 1 &&
													'pr-16',
											]}
										>
											{column}
										</th>
									))}
								</tr>
							</thead>
							<tbody>
								{PACKAGING_SPECS_PAGE.specTable.rows.map((row) => (
									<tr class="border-b border-gray-vlight">
										<th
											scope="row"
											class="py-12 pr-16 text-p-sm font-bold text-blue-dark3"
										>
											{row.attribute}
										</th>
										{row.values.map((value, index) => (
											<td
												class:list={[
													'py-12 text-p-sm text-gray',
													index < row.values.length - 1 && 'pr-16',
												]}
											>
												{value}
											</td>
										))}
									</tr>
								))}
							</tbody>
						</table>
					</div>

					<p class="mt-24 text-p-sm text-gray">
						The packing specification is confirmed in writing before production starts. How the
						labelling is executed as part of a distributor programme is covered on the{' '}
						<a
							href="/services/compliance-packaging/distributor-labeling-packaging/"
							class="text-blue underline"
						>
							packaging capability page
						</a>.
					</p>
				</section>
			)
		}

		<KnowledgeHubFacts facts={PACKAGING_SPECS_PAGE.facts} heading="At a glance" />

		<AboutUsCta
			heading="Send the label data and we will confirm the packing"
			body="Tell us the item number, the barcode format, the carton configuration and the shipping route. We confirm the packing specification, the documents that travel with the lot and the delivery date in writing."
		/>
	</main>

	<SiteFooter />
	<CookieConsent />
	<BackToTop />
</BaseLayout>
