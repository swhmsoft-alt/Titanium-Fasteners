---
/**
 * /knowledge-hub/ip-protection/nda-ip-protection-policy/
 *
 * NDA 与知识产权保护 —— 明确承诺：审图前先签具有法律效力的双语 NDA，
 * 图纸加密隔离，绝不展示任何客户私有设计。
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SiteHeader from '@components/layout/SiteHeader.astro';
import MegaMenu from '@components/layout/MegaMenu.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import CookieConsent from '@components/layout/CookieConsent.astro';
import BackToTop from '@components/layout/BackToTop.astro';
import KnowledgeHubHero from '@components/sections/knowledge-hub/KnowledgeHubHero.astro';
import KnowledgeHubFacts from '@components/sections/knowledge-hub/KnowledgeHubFacts.astro';
import AboutUsCta from '@components/sections/about-us/AboutUsCta.astro';
import { NDA_IP_POLICY_PAGE } from '@data/knowledge-hub';

const currentPathname = Astro.url.pathname;
---

<BaseLayout
	title={NDA_IP_POLICY_PAGE.seo.title}
	description={NDA_IP_POLICY_PAGE.seo.description}
	canonicalPath={NDA_IP_POLICY_PAGE.path}
>
	<SiteHeader currentPathname={currentPathname} />
	<MegaMenu />

	<main id="main" class="pt-48 md:pt-91">
		<KnowledgeHubHero {...NDA_IP_POLICY_PAGE.hero} />

		{
			NDA_IP_POLICY_PAGE.body.map((paragraph) => (
				<div class="container-fluid">
					<p class="text-p pb-12 text-gray lg:pb-20 max-w-rich-text">{paragraph}</p>
				</div>
			))
		}

		<KnowledgeHubFacts facts={NDA_IP_POLICY_PAGE.facts} heading="At a glance" />

		<AboutUsCta
			heading="Send the drawing under NDA"
			body="We will issue our bilingual confidentiality agreement for your countersignature first. Once it is in place, we open the drawing and answer with a quotation, the grade and the certification route."
		/>
	</main>

	<SiteFooter />
	<CookieConsent />
	<BackToTop />
</BaseLayout>
