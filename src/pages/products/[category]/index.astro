---
/**
 * /products/<category_id>/ — 产品分类页（Phase B 自有内容）。
 *
 * 版式复用已验收的品类页模板（参考站 /products/.../c/01.100/）：
 *   面包屑 → H1 → 分类横滑轨（CategoryCardRail）→ 左侧筛选栏 + 右侧族卡（ProductGrid）
 * 数据不再照抄参考站，而是由 data/products/*.csv 生成（见 scripts/gen-products.mjs）。
 *
 * 分类维度只有两层（category → family），所以「横滑轨」放的是**全部分类**（导航），
 * 右侧网格放的是**本分类下的族**。
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SiteHeader from '@components/layout/SiteHeader.astro';
import MegaMenu from '@components/layout/MegaMenu.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import CookieConsent from '@components/layout/CookieConsent.astro';
import BackToTop from '@components/layout/BackToTop.astro';
import CategoryCardRail from '@components/sections/category/CategoryCardRail.astro';
import ProductGrid from '@components/sections/category/ProductGrid.astro';
import { SITE } from '@config/site';
import { CATEGORY_VIEWS, FILTER_GROUPS, categoryPath, type CategoryView } from '@data/products';

export function getStaticPaths() {
	return Object.values(CATEGORY_VIEWS).map((view) => ({
		params: { category: view.id },
		props: { view },
	}));
}

const { view } = Astro.props as { view: CategoryView };

const currentPathname = Astro.url.pathname;
const canonicalPath = categoryPath(view.id);

/**
 * draft 族不出 sitemap、页面 noindex —— 与 /products/<category>/<family>/ 同规则。
 * 一个分类下只要有 published 族，整页就可索引。
 */
const hasPublished = view.hasPublished;

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'CollectionPage',
		name: `${view.heading} — Titanium Fasteners`,
		description: view.description,
		url: new URL(canonicalPath, SITE.url).href,
		mainEntity: {
			'@type': 'ItemList',
			itemListElement: view.products.map((p, i) => ({
				'@type': 'ListItem',
				position: i + 1,
				name: p.title,
				url: new URL(p.href, SITE.url).href,
			})),
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: view.breadcrumb.map((c, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: c.label,
			item: new URL(c.href, SITE.url).href,
		})),
	},
];
---

<BaseLayout
	title={`${view.heading} — Titanium Fasteners`}
	description={view.description}
	canonicalPath={canonicalPath}
	jsonLd={jsonLd}
>
	{!hasPublished && <meta name="robots" content="noindex, nofollow" />}

	<SiteHeader currentPathname={currentPathname} />
	<MegaMenu />

	<main id="main" class="pt-48 md:pt-91">
		<div class="container-fluid pt-16 lg:pt-24">
			<nav
				class="opacity-100 mb-24 mt-8 overflow-hidden text-gray-medium transition-opacity duration-300 lg:mb-32 lg:mt-12"
				aria-label="Breadcrumb"
			>
				<ol class="flex text-p-l">
					{
						view.breadcrumb.map((crumb, i) => (
							<li
								class:list={[
									'flex items-center',
									i === view.breadcrumb.length - 1 &&
										'flex-shrink-1 flex-grow-0 truncate whitespace-nowrap',
								]}
							>
								{i > 0 && (
									<svg
										class="h-16 w-16 inline-block fill-gray-medium stroke-gray-medium stroke-[1.75] mx-8 lg:mx-12 mb-4"
										aria-hidden="true"
									>
										<use href="/images/sprite.svg#chevron-right"></use>
									</svg>
								)}
								{i === 0 ? (
									<a href={crumb.href}>
										<svg class="h-16 w-16 fill-gray-medium stroke-gray-medium stroke-[2]" aria-hidden="true">
											<use href="/images/sprite.svg#home"></use>
										</svg>
										<span class="sr-only">{crumb.label}</span>
									</a>
								) : i === view.breadcrumb.length - 1 ? (
									<span aria-current="page">{crumb.label}</span>
								) : (
									<a href={crumb.href} class="whitespace-nowrap">
										{crumb.label}
									</a>
								)}
							</li>
						))
					}
				</ol>
			</nav>

			<h1 class="text-h4 mb-12 text-blue-dark3 md:mb-16">{view.heading}</h1>
			<p class="mb-24 max-w-[760px] text-p text-gray">{view.description}</p>

			<section class="pb-48 lg:pb-56">
				<CategoryCardRail />
			</section>

			<div class="md:pt-20 lg:pt-24">
				<ProductGrid
					products={view.products}
					filterGroups={FILTER_GROUPS}
					productCount={view.productCount}
				/>
			</div>
		</div>
	</main>

	<SiteFooter />
	<CookieConsent />
	<BackToTop />
</BaseLayout>
