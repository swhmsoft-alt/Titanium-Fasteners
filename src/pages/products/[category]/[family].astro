---
/**
 * /products/<category_id>/<family_id>/ — 产品族详情页（Phase B）。
 *
 * URL 形态已定死：全站产品区统一到 /products/ 前缀，族路由带分类层。
 * 仓库禁止任何跳转/重定向，所以这个路径一旦生成就是契约。
 *
 * 页面的 SEO 主体是**规格矩阵表** —— 每行是一个可检索的长尾短语
 * （"M6" + "20" + "DIN 912"）。因此：
 *   · 表格是静态 HTML <table>（见 FamilySpecTable.astro）；
 *   · 每行有独立锚点链接，询盘岛可据此带入规格上下文；
 *   · JSON-LD 用 ProductGroup + hasVariant，把每个规格行声明为一个变体。
 *
 * 全页零客户端 JS 除询盘岛外。
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SiteHeader from '@components/layout/SiteHeader.astro';
import MegaMenu from '@components/layout/MegaMenu.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import CookieConsent from '@components/layout/CookieConsent.astro';
import BackToTop from '@components/layout/BackToTop.astro';
import FamilyHero from '@components/sections/product-family/FamilyHero.astro';
import FamilySpecTable from '@components/sections/product-family/FamilySpecTable.astro';
import FamilyInquiry from '@components/sections/product-family/FamilyInquiry.astro';
import { SITE } from '@config/site';
import {
	CATEGORIES,
	DIMENSIONS,
	PRODUCT_ROUTE_BASE,
	FAMILIES,
	MATERIALS,
	PARAM_SCHEMA,
	PUBLISHED_FAMILIES,
	categoryPath,
	familyPath,
	type Family,
} from '@data/products';

export function getStaticPaths() {
	/* draft 也出页面（内网/预览可用），但输出 noindex —— 不进索引、不被 canonical
	   之外的渠道引用。sitemap 的过滤在 astro.config.mjs 里按路径做。
	   路由是两层：/products/<category>/<family>/ —— category 取自族自身的归属。 */
	return FAMILIES.map((family) => ({
		params: { category: family.category, family: family.family_id },
		props: { family },
	}));
}

const { family } = Astro.props as { family: Family };

const canonicalPath = familyPath(family.category, family.family_id);
const currentPathname = Astro.url.pathname;

const rows = DIMENSIONS[family.family_id] ?? [];
const params = PARAM_SCHEMA.filter((p) => p.type === family.type).sort((a, b) => Number(a.order) - Number(b.order));
const list = (v: string) => v.split('|').filter(Boolean);
const materialName = (id: string) => MATERIALS.find((m) => m.id === id)?.name ?? id;

const isPublished = PUBLISHED_FAMILIES.some((f) => f.family_id === family.family_id);

const category = CATEGORIES.find((c) => c.id === family.category);

/** 变体的尺寸属性 —— 参数定义（不含 thread/length，它们进 name）。 */
const variantParams = params.filter((p) => p.param !== 'thread' && p.param !== 'length');

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'ProductGroup',
		name: family.name,
		description: family.description,
		brand: { '@type': 'Brand', name: SITE.name },
		manufacturer: { '@type': 'Organization', name: SITE.name },
		category: 'Fasteners > Titanium Fasteners',
		url: new URL(canonicalPath, SITE.url).href,
		hasVariant: rows.map((row) => ({
			'@type': 'Product',
			name: `${family.name} ${row.thread ?? ''} x ${row.length ?? ''}`.trim(),
			sku: row.key,
			material: list(family.materials).map(materialName).join(', '),
			additionalProperty: variantParams.map((p) => ({
				'@type': 'PropertyValue',
				name: p.label,
				value: row[p.param] ?? '',
				unitText: p.unit === '-' ? undefined : p.unit,
			})),
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', SITE.url).href },
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Products',
				item: new URL(PRODUCT_ROUTE_BASE, SITE.url).href,
			},
			...(category
				? [
						{
							'@type': 'ListItem',
							position: 3,
							name: category.name,
							item: new URL(categoryPath(category.id), SITE.url).href,
						},
					]
				: []),
			{
				'@type': 'ListItem',
				position: category ? 4 : 3,
				name: family.name,
				item: new URL(canonicalPath, SITE.url).href,
			},
		],
	},
];
---

<BaseLayout
	title={family.seo_title || family.name}
	description={family.seo_description || family.description}
	canonicalPath={canonicalPath}
	jsonLd={jsonLd}
>
	{!isPublished && <meta name="robots" content="noindex, nofollow" />}

	<SiteHeader currentPathname={currentPathname} />
	<MegaMenu />

	<main id="main">
		<FamilyHero family={family} canonicalPath={canonicalPath} />
		<FamilySpecTable family={family} />
		<FamilyInquiry family={family} canonicalPath={canonicalPath} />
	</main>

	<SiteFooter />
	<CookieConsent />
	<BackToTop />
</BaseLayout>
