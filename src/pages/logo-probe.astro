---
/**
 * Phase 0 probe — brand asset verification surface.
 *
 * Renders the real site header (so the shipped logo is measured in its
 * production context) plus every brand asset on every surface it may land
 * on (white header / graphite plate / dark band), the favicon at its real
 * browser sizes, and the E-width clear-space rule.
 *
 * Every specimen is wrapped in a <figure data-ratio="…"> that contains ONLY
 * the artwork, so `npm run measure -- /logo-probe/ --target qa/targets/logo.json`
 * measures the real box and flags any ratio distortion. Captions live
 * OUTSIDE the figure — a caption inside would change the measured box.
 *
 * Diagnostic only: excluded from the sitemap and disallowed in robots.txt.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SiteHeader from '@components/layout/SiteHeader.astro';
import Logo from '@components/layout/Logo.astro';
import { LOGO, SITE } from '@config/site';

const variants = [
	{ key: 'mono', label: 'mono', src: LOGO.assets.mono, note: 'graphite flat', ratio: LOGO.claim.ratio },
	{ key: 'reverse', label: 'reverse', src: LOGO.assets.reverse, note: 'white flat', ratio: LOGO.claim.ratio },
	{ key: 'compact', label: 'compact', src: LOGO.assets.compact, note: 'simplified wordmark', ratio: LOGO.compact.ratio },
	{ key: 'lockup', label: 'lockup', src: LOGO.assets.lockup, note: 'mark + rule + tagline', ratio: LOGO.lockup.ratio },
];

const surfaces = [
	{ key: 'white', label: 'white — header', class: 'bg-white border border-gray-light', tone: 'text-gray-medium' },
	{ key: 'plate', label: 'graphite plate #1E2225', class: 'bg-[#1E2225]', tone: 'text-white' },
	{
		key: 'dark',
		label: 'dark metal band',
		class: '',
		tone: 'text-white',
		style: 'background:linear-gradient(135deg,#4A4E51 0%,#2B2F33 55%,#17191B 100%)',
	},
];

/** Intrinsic ratio of each rendered logo slot. */
const claimRatio = +(LOGO.claim.displayWidth / LOGO.claim.displayHeight).toFixed(3);
const compactRatio = +(LOGO.compact.displayWidth / LOGO.compact.displayHeight).toFixed(3);

/** Favicon specimens — the real browser tab sizes. */
const faviconSizes = [16, 32, 64];
---

<BaseLayout title="Logo probe" description="Diagnostic page for brand and logo geometry verification.">
	<SiteHeader />

	<main id="main" class="pt-48 md:pt-91">
		<section>
			<div class="container-reference py-64">
				<h1 class="text-h1 text-blue-dark3">Brand &amp; logo probe</h1>
				<p class="text-lead mt-24 max-w-[782px]">
					Brand: <strong>{LOGO.alt}</strong> · deployment
					<code>{SITE.url}</code> · artwork {LOGO.claim.width}×{LOGO.claim.height}
					(ratio {LOGO.claim.ratio})
				</p>
			</div>
		</section>

		<section>
			<div class="container-reference py-24">
				<h2 class="text-h3 text-blue-dark3">A · Header treatment — graphite flat on white</h2>
				<p class="text-p mt-16 max-w-[782px]">
					The brand system was rebuilt for the opaque white header: flat 2D solid fills only,
					no gradients and no drop-shadow filters. Cut-outs are TRUE TRANSPARENT, so the mark
					also drops onto dark plates and single-colour print unchanged.
				</p>
				<div class="mt-16 flex items-center justify-between border border-gray-light bg-white p-16">
					<div>
						<figure class="inline-block" data-ratio={claimRatio}>
							<Logo variant="claim" tone="mono" />
						</figure>
						<p class="text-label text-gray-medium mt-8">
							claim mono · {LOGO.claim.displayWidth}×{LOGO.claim.displayHeight}px
						</p>
					</div>
					<span class="text-label text-gray-medium">header slot</span>
				</div>
			</div>
		</section>

		<section>
			<div class="container-reference py-24">
				<h2 class="text-h3 text-blue-dark3">B · Clear space — E-width rule</h2>
				<p class="text-p mt-16 max-w-[782px]">
					Nothing may enter a band of <strong>{LOGO.clearSpace.units}</strong> source units around
					the mark — the width of the "E" of BOZE. At the 190px desktop render that is
					<strong>{LOGO.clearSpace.pxAtClaim}px</strong> on every side (dashed frame below).
					The navbar satisfies it on the left through the container padding (70px at ≥1280);
					the 32px gap to the nav row is the measured reference value and is left untouched.
				</p>
				<div class="mt-16 border border-gray-light bg-white p-16">
					<div
						class="inline-block border border-dashed border-accent-rose"
						style={`padding:${LOGO.clearSpace.pxAtClaim}px`}
					>
						<figure class="inline-block" data-ratio={claimRatio}>
							<Logo variant="claim" tone="mono" />
						</figure>
					</div>
					<p class="text-label text-gray-medium mt-8">
						clear space · {LOGO.clearSpace.pxAtClaim}px = E width ({LOGO.clearSpace.units} units)
					</p>
				</div>
			</div>
		</section>

		<section>
			<div class="container-reference py-24">
				<h2 class="text-h3 text-blue-dark3">C · Compact variant (&lt;768px header)</h2>
				<div class="mt-16 flex items-center justify-between border border-gray-light bg-white p-16">
					<div>
						<figure class="inline-block" data-ratio={compactRatio}>
							<Logo variant="compact" />
						</figure>
						<p class="text-label text-gray-medium mt-8">
							compact · {LOGO.compact.displayWidth}×{LOGO.compact.displayHeight}px
						</p>
					</div>
					<span class="text-label text-gray-medium">mobile slot</span>
				</div>
			</div>
		</section>

		<section>
			<div class="container-reference py-24">
				<h2 class="text-h3 text-blue-dark3">D · Favicon — graphite plate + white BO</h2>
				<p class="text-p mt-16 max-w-[782px]">
					Rounded-square graphite plate (#1E2225) with the bolt B and the nut O knocked out in
					white. The plate travels with the icon, so the mark keeps 100% recognition on light,
					grey or dark browser chrome. Thread slots and the hex socket stay transparent, so
					they read as machined recesses in the plate.
				</p>
				<div class="mt-16 flex items-end gap-32 border border-gray-light bg-white p-24">
					{
						faviconSizes.map((size) => (
							<figure class="inline-block" data-ratio={1}>
								<img
									src="/favicon.svg"
									alt={`favicon at ${size}px`}
									width={size}
									height={size}
									class="block h-auto"
								/>
							</figure>
						))
					}
					<span class="text-label text-gray-medium ml-auto">16 / 32 / 64 px</span>
				</div>
			</div>
		</section>

		<section>
			<div class="container-reference py-24">
				<h2 class="text-h3 text-blue-dark3">E · Asset × surface matrix</h2>
				<p class="text-p mt-16 max-w-[782px]">
					Every asset on every surface, at a fixed 300px width. The `data-ratio` attribute
					carries the intrinsic ratio, so the verifier flags any distortion.
				</p>
				<div class="mt-16 grid grid-cols-1 gap-24 lg:grid-cols-3">
					{
						surfaces.map((surface) => (
							<div class:list={['p-24', surface.class]} style={surface.style}>
								<p class:list={['text-label mb-16', surface.tone]}>{surface.label}</p>
								{variants.map((variant) => (
									<div class="mb-20 last:mb-0">
										<figure class="inline-block" data-ratio={variant.ratio}>
											<img
												src={variant.src}
												alt={`${variant.label} asset`}
												width="300"
												class="block h-auto w-[300px]"
											/>
										</figure>
										<p class:list={['text-label mt-8', surface.tone]}>
											{variant.label} · {variant.note}
										</p>
									</div>
								))}
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section>
			<div class="container-reference py-24">
				<h2 class="text-h3 text-blue-dark3">Token regression</h2>
				<div class="mt-16 grid grid-cols-1 gap-24 md:grid-cols-2 lg:gap-32">
					<div class="bg-blue-light p-32">p-32 → expect 32px</div>
					<div class="bg-blue-light p-32">p-32 → expect 32px</div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
