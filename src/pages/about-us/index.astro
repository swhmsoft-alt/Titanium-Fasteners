---
/**
 * /about-us/ — 落地页。
 *
 * 三列工厂背书入口，每列 3 个条目，全部链到 /about-us/<group>/<slug>/。
 * 内容与结构来自 src/data/about-us.ts（唯一真相源）。
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SiteHeader from '@components/layout/SiteHeader.astro';
import MegaMenu from '@components/layout/MegaMenu.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import CookieConsent from '@components/layout/CookieConsent.astro';
import BackToTop from '@components/layout/BackToTop.astro';
import AboutUsHero from '@components/sections/about-us/AboutUsHero.astro';
import AboutUsItemGrid from '@components/sections/about-us/AboutUsItemGrid.astro';
import AboutUsCta from '@components/sections/about-us/AboutUsCta.astro';
import { ABOUT_US_GROUPS, ABOUT_US_LANDING } from '@data/about-us';

const currentPathname = Astro.url.pathname;
const { seo, hero, intro } = ABOUT_US_LANDING;
---

<BaseLayout title={seo.title} description={seo.description} canonicalPath="/about-us/">
	<SiteHeader currentPathname={currentPathname} />
	<MegaMenu />

	<main id="main" class="pt-48 md:pt-91">
		<AboutUsHero {...hero} />

		<div class="container-fluid">
			<p class="text-p pb-12 text-gray lg:pb-20 max-w-rich-text">{intro}</p>
		</div>

		{
			ABOUT_US_GROUPS.map((group) => (
				<section class="container-fluid pb-48 pt-32 lg:pb-56 lg:pt-40">
					<h2 class="text-h3 mb-16 text-blue-dark3 lg:mb-24">{group.heading}</h2>
					<p class="text-p mb-24 text-gray max-w-rich-text lg:mb-32">{group.description}</p>
					<AboutUsItemGrid items={group.items} />
				</section>
			))
		}

		<AboutUsCta />
	</main>

	<SiteFooter />
	<CookieConsent />
	<BackToTop />
</BaseLayout>
